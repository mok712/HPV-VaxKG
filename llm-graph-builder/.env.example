# Neo4j 连接
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# DeepSeek（LLM）
LLM_MODEL_CONFIG_deepseek="deepseek-chat,https://api.deepseek.com,sk-你的DeepSeek密钥"
VITE_LLM_MODELS="deepseek"

# 阿里云百炼（Embedding）
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_PROVIDER="openai"
OPENAI_API_KEY="sk-你的百炼密钥"
OPENAI_BASE_URL="https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"