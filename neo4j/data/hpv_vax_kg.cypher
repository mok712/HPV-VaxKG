:begin
CREATE CONSTRAINT entity_nodeid FOR (node:Entity) REQUIRE (node.nodeId) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
:begin
UNWIND [{nodeId:"SCH001", properties:{label_zh:"接种方案", dose_count:2, name:"2剂次(0,6月)", interval:"0,6月", label_en:"VaccinationSchedule"}}, {nodeId:"SCH002", properties:{label_zh:"接种方案", name:"总接种剂次由年龄决定", label_en:"VaccinationSchedule"}}, {nodeId:"SCH003", properties:{label_zh:"接种方案", dose_count:3, name:"3剂次(0,2,6月)", interval:"0,2,6月", label_en:"VaccinationSchedule"}}, {nodeId:"SCH004", properties:{label_zh:"接种方案", dose_count:3, name:"3剂次(0,6,12月)", interval:"0,6,12月", label_en:"VaccinationSchedule"}}, {nodeId:"SCH005", properties:{label_zh:"接种方案", dose_count:1, name:"单剂次（超说明书使用）", label_en:"VaccinationSchedule"}}, {nodeId:"SCH006", properties:{label_zh:"接种方案", name:"确认完成接种程序", label_en:"VaccinationSchedule"}}, {nodeId:"SCH007", properties:{label_zh:"接种方案", name:"剂量", label_en:"VaccinationSchedule"}}, {nodeId:"SCH008", properties:{label_zh:"接种方案", dose_count:1, name:"单剂次方案（常规推荐）", label_en:"VaccinationSchedule", name_en:"single-dose schedule (routine)"}}, {nodeId:"SCH009", properties:{label_zh:"接种方案", dose_count:3, name:"3剂次(0,1-2,6月)", interval:"0,1-2,6月", label_en:"VaccinationSchedule", name_en:"3-dose schedule (0, 1-2, 6 months)"}}, {nodeId:"SCH010", properties:{label_zh:"接种方案", dose_count:3, name:"3剂次(0,1,4-6月)", interval:"0,1,4-6月", label_en:"VaccinationSchedule", name_en:"3-dose schedule (0, 1, 4-6 months)"}}, {nodeId:"SCH011", properties:{dose_count:3, label_zh:"接种方案", name:"Cervarix≥15岁3剂次(0,1-2.5,5-12月)", interval:"0,1-2.5,5-12月", label_en:"VaccinationSchedule", name_en:"Cervarix ≥15y: 3 doses (0, 1-2.5, 5-12 months)"}}, {nodeId:"SCH012", properties:{dose_count:3, label_zh:"接种方案", name:"Cecolin≥15岁3剂次(0,1-2,5-8月)", interval:"0,1-2,5-8月", label_en:"VaccinationSchedule", name_en:"Cecolin ≥15y: 3 doses (0, 1-2, 5-8 months)"}}, {nodeId:"SCH013", properties:{dose_count:3, label_zh:"接种方案", name:"Walrinvax≥15岁3剂次(0,2-3,6-7月)", interval:"0,2-3,6-7月", label_en:"VaccinationSchedule", name_en:"Walrinvax ≥15y: 3 doses (0, 2-3, 6-7 months)"}}, {nodeId:"SCH014", properties:{dose_count:3, label_zh:"接种方案", name:"Gardasil≥14岁/Gardasil9≥15岁3剂次(0,1-2,4-6月)", interval:"0,1-2,4-6月", label_en:"VaccinationSchedule", name_en:"Gardasil ≥14y / Gardasil9 ≥15y: 3 doses (0, 1-2, 4-6 months)"}}, {nodeId:"SCH015", properties:{label_zh:"接种方案", dose_count:2, name:"2剂次(间隔5-13月)", interval:"5-13月", label_en:"VaccinationSchedule", name_en:"2-dose schedule (5-13 months apart)"}}, {nodeId:"SCH016", properties:{dose_count:2, label_zh:"接种方案", name:"2剂次(间隔≥24周)", interval:"≥24周", label_en:"VaccinationSchedule", name_en:"2-dose schedule (≥24 weeks apart)"}}, {nodeId:"SCH017", properties:{label_zh:"接种方案", dose_count:2, name:"2剂次(间隔6-12月)", interval:"6-12月", label_en:"VaccinationSchedule", name_en:"2-dose schedule (6-12 months)"}}, {nodeId:"SCH018", properties:{label_zh:"接种方案", dose_count:2, name:"2剂次(间隔6-15月)", interval:"6-15月", label_en:"VaccinationSchedule", name_en:"2-dose schedule (0, 6-15 months)"}}, {nodeId:"SCH019", properties:{dose_count:2, label_zh:"接种方案", name:"2剂次(间隔≥5月)", interval:"≥5月", label_en:"VaccinationSchedule", name_en:"2-dose schedule (at least 5 months apart)"}}, {nodeId:"SCH020", properties:{dose_count:3, label_zh:"接种方案", name:"3剂次方案（未指明间隔）", label_en:"VaccinationSchedule", name_en:"3-dose schedule (intervals unspecified)"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:接种方案;
UNWIND [{nodeId:"SCH021", properties:{dose_count:2, label_zh:"接种方案", name:"2剂次方案（未指明间隔）", label_en:"VaccinationSchedule", name_en:"2-dose schedule (intervals unspecified)"}}, {nodeId:"SCH023", properties:{label_zh:"接种方案", name:"2剂或3剂方案", label_en:"VaccinationSchedule", name_en:"2- or 3-dose schedule"}}, {nodeId:"SCH025", properties:{label_zh:"接种方案", dose_count:2, name:"2剂次(0,6-24月)", interval:"0,6-24月", label_en:"VaccinationSchedule", name_en:"2-dose schedule (0, 6 to 24 months)"}}, {nodeId:"SCH026", properties:{dose_count:2, label_zh:"接种方案", name:"2剂次（间隔≥6月）", interval:"≥6月", label_en:"VaccinationSchedule", name_en:"2-dose schedule (at least 6 months apart)"}}, {nodeId:"SCH027", properties:{label_zh:"接种方案", name:"1剂或2剂方案", label_en:"VaccinationSchedule", name_en:"1 or 2 dose(s)"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:接种方案;
UNWIND [{nodeId:"VAC001", properties:{label_zh:"疫苗", level:2, name:"2价HPV疫苗", label_en:"Vaccine"}}, {nodeId:"VAC002", properties:{label_zh:"疫苗", level:4, name:"4价HPV疫苗", label_en:"Vaccine"}}, {nodeId:"VAC003", properties:{label_zh:"疫苗", level:9, name:"9价HPV疫苗", label_en:"Vaccine"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:疫苗;
UNWIND [{nodeId:"CONC001", properties:{label_zh:"结论", name:"9vHPV疫苗对27-45岁女性免疫原性非劣效于年轻女性", label_en:"Conclusion", name_en:"9vHPV shows non-inferior immunogenicity in women 27-45y vs younger women"}}, {nodeId:"CONC002", properties:{label_zh:"结论", name:"4vHPV疫苗可预防疫苗型病毒引起的CIN或生殖器疣长达十年", label_en:"Conclusion", name_en:"4vHPV prevents CIN or genital warts from vaccine-type virus for up to a decade"}}, {nodeId:"CONC003", properties:{label_zh:"结论", name:"2vHPV疫苗降低持续感染、任意CIN或外生殖器病变的效力达90.5%", label_en:"Conclusion", name_en:"2vHPV exhibits 90.5% efficacy in reducing persistent infection, any CIN, or external genital lesions"}}, {nodeId:"CONC004", properties:{label_zh:"结论", name:"尚无针对27-45岁成年男性的HPV疫苗接种随机对照试验", label_en:"Conclusion", name_en:"no RCT of HPV vaccination for adult males aged 27-45 years"}}, {nodeId:"CONC005", properties:{label_zh:"结论", name:"成人3剂次方案推荐证据来源于随机对照试验", label_en:"Conclusion", name_en:"3-dose schedule recommendation derived from RCTs"}}, {nodeId:"CONC006", properties:{label_zh:"结论", name:"1剂和2剂方案在事后分析中结果有希望，但真实世界数据结果不一致", label_en:"Conclusion", name_en:"1- and 2-dose schedules showed promising results in post-hoc analyses, but real-world data discrepant"}}, {nodeId:"CONC007", properties:{label_zh:"结论", name:"口咽HPV感染预防的现有证据依赖2vHPV和4vHPV（15-26岁女性及HIV人群）", label_en:"Conclusion", name_en:"current evidence relies on 2vHPV and 4vHPV for females 15-26y and people with HIV"}}, {nodeId:"CONC008", properties:{label_zh:"结论", name:"三种HPV疫苗总体耐受性良好", label_en:"Conclusion", name_en:"all three vaccines are generally well-tolerated"}}, {nodeId:"CONC009", properties:{label_zh:"结论", name:"上市前试验中4价与2价疫苗均未记录到可归因于疫苗的严重不良事件", label_en:"Conclusion", name_en:"no serious adverse events attributable to quadrivalent or bivalent vaccine in prelicensure trials"}}, {nodeId:"CONC010", properties:{label_zh:"结论", name:"9价疫苗可归因严重不良事件率<0.1%", label_en:"Conclusion", name_en:"rate of serious adverse events attributable to nonavalent vaccine <0.1%"}}, {nodeId:"CONC011", properties:{label_zh:"结论", name:"当前证据支持2剂次方案用于9岁起主要目标人群及各许可年龄组", label_en:"Conclusion", name_en:"current evidence supports 2-dose schedule from 9 years and all older licensed age groups"}}, {nodeId:"CONC012", properties:{label_zh:"结论", name:"单剂次方案可作为9-20岁女孩和男孩的超说明书选择", label_en:"Conclusion", name_en:"single-dose schedule can be used as off-label option in girls and boys 9-20 years"}}, {nodeId:"CONC013", properties:{label_zh:"结论", name:"免疫桥接证据=峰值及24个月平台期抗体水平与已证实单剂次效力的疫苗相当", label_en:"Conclusion", name_en:"immunobridging: peak and 24-month plateau antibody levels comparable to vaccines with proven single-dose efficacy"}}, {nodeId:"CONC014", properties:{label_zh:"结论", name:"二十余年安全性监测未发现HPV疫苗引起严重副作用；最常见为注射部位短暂疼痛等局部症状", label_en:"Conclusion", name_en:"no serious side effects in >2 decades of monitoring; most common are brief local symptoms"}}, {nodeId:"CONC015", properties:{label_zh:"结论", name:"疫苗对目标HPV型别感染的保护持续十年以上", label_en:"Conclusion", name_en:"vaccine protection against targeted HPV types lasts more than a decade"}}, {nodeId:"CONC016", properties:{label_zh:"结论", name:"疫苗已被证明可预防最高至45岁的新发感染和疾病", label_en:"Conclusion", name_en:"vaccines demonstrated to prevent new infections and disease up to age 45"}}, {nodeId:"CONC017", properties:{label_zh:"结论", name:"多年龄队列（9-18岁）接种比单年龄队列产生更高更快的人群影响（群体效应/间接保护/男性直接保护）", label_en:"Conclusion", name_en:"multi-age-cohort vaccination (9-18y) led to higher and faster population impact than single cohorts"}}, {nodeId:"CONC018", properties:{label_zh:"结论", name:"WHO、Cochrane图书馆、ESGO、EFC推荐9-14岁女孩2剂次方案(0,6-15月)", label_en:"Conclusion", name_en:"WHO, Cochrane, ESGO, EFC recommend 2-dose schedule (0, 6-15 months) in girls 9-14 years"}}, {nodeId:"CONC019", properties:{label_zh:"结论", name:"MSM在所有年龄段、无论HIV状态均有更高的反复及持续HPV感染和相关疾病（生殖器疣、肛门癌）风险", label_en:"Conclusion", name_en:"MSM have higher risk of repeated and persistent HPV infection and diseases at all ages"}}, {nodeId:"CONC020", properties:{label_zh:"结论", name:"接种者注射部位反应：疼痛35-88%、红5-40%、肿4-35%，约6%报告严重疼痛", label_en:"Conclusion", name_en:"injection site reactions: pain 35-88%, redness 5-40%, swelling 4-35%; severe pain ~6%"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:结论;
UNWIND [{nodeId:"CONC021", properties:{label_zh:"结论", name:"27-45岁接种有效性低、癌症预防潜力低，且决策负担大、获益人群选择指导不足", label_en:"Conclusion", name_en:"low effectiveness and cancer prevention potential in 27-45y, decision burden, lack of selection guidance"}}, {nodeId:"CONC022", properties:{label_zh:"结论", name:"成本效益评估不支持在人群计划中推荐9价疫苗再接种", label_en:"Conclusion", name_en:"cost-effectiveness does not permit recommendation of revaccination in population-based programs"}}, {nodeId:"CONC023", properties:{label_zh:"结论", name:"学校接种项目或组织良好的公共卫生结构最有效、确保公平、远优于机会性接种", label_en:"Conclusion", name_en:"school-based programs most effective, ensure equity, far superior to opportunistic vaccination"}}, {nodeId:"CONC024", properties:{label_zh:"结论", name:"许多成人可能已通过性活动暴露于疫苗所含1种或多种HPV型别", label_en:"Conclusion", name_en:"many adults likely exposed to ≥1 vaccine HPV types through sexual activity"}}, {nodeId:"CONC025", properties:{label_zh:"结论", name:"HPV疫苗与其他疫苗同时接种安全（百日咳/白喉/破伤风/脊灰/甲乙肝/流脑/新冠等）", label_en:"Conclusion", name_en:"concurrent administration with other vaccines tested and demonstrated safe"}}, {nodeId:"CONC026", properties:{label_zh:"结论", name:"2价、4价和9价疫苗对宫颈癌前病变和癌症（主要由16/18型引起）的免疫原性、效力和效果相当", label_en:"Conclusion", name_en:"all licensed vaccines offer comparable immunogenicity, efficacy and effectiveness for cervical precancer and cancer"}}, {nodeId:"CONC027", properties:{label_zh:"结论", name:"疫苗在初次性生活早期接种效果最佳且接种时HPV阳性可能性更低", label_en:"Conclusion", name_en:"vaccination early in life gives optimal immunologic response and decreases likelihood of HPV positivity"}}, {nodeId:"CONC028", properties:{label_zh:"结论", name:"疫苗对既往感染已清除的性活跃女性和男性仍有效", label_en:"Conclusion", name_en:"vaccines also effective in sexually active women and men with previous but cleared infections"}}, {nodeId:"CONC029", properties:{label_zh:"结论", name:"HPV疫苗接种是初级预防干预，不能消除日后筛查的需要", label_en:"Conclusion", name_en:"HPV vaccination is primary prevention and does not eliminate the need for screening"}}, {nodeId:"CONC031", properties:{label_zh:"结论", name:"无证据支持完成全程接种后需要加强针（保护可能终身）", label_en:"Conclusion", name_en:"no evidence to support the need for a booster, although protection may be lifelong"}}, {nodeId:"CONC032", properties:{label_zh:"结论", name:"HPV疫苗在免疫功能低下或HIV感染者中安全且耐受良好", label_en:"Conclusion", name_en:"HPV vaccines are safe and well tolerated in immunocompromised or HIV-infected persons"}}, {nodeId:"CONC034", properties:{label_zh:"结论", name:"旅行者和卫生工作者感染HPV风险不增加，应遵循一般人群建议", label_en:"Conclusion", name_en:"travelers and health workers not at increased risk, follow general recommendations"}}, {nodeId:"CONC035", properties:{label_zh:"结论", name:"在资源允许下性别中立接种是应优先采用的理念", label_en:"Conclusion", name_en:"gender-neutral vaccination should be the preferred concept where resources allow"}}, {nodeId:"CONC036", properties:{label_zh:"结论", name:"对已感染HPV者接种仍可能因预防未感染型别而获得残余获益", label_en:"Conclusion", name_en:"previously infected persons likely still get residual benefit from vaccination"}}, {nodeId:"CONC037", properties:{label_zh:"结论", name:"疫苗未覆盖的HPV型别也可引起宫颈癌，接种后仍需筛查", label_en:"Conclusion", name_en:"HPV types other than vaccine types can cause cervical cancer; screening still needed"}}, {nodeId:"CONC038", properties:{label_zh:"结论", name:"临床试验最常见不良反应为注射部位局部反应（20%-90%），发热比例与安慰剂相似", label_en:"Conclusion", name_en:"most common adverse reactions in trials were local reactions (20%-90%); fever rates similar to placebo"}}, {nodeId:"CONC039", properties:{label_zh:"结论", name:"22-26岁接种降低癌症风险效果较差", label_en:"Conclusion", name_en:"vaccination at older ages (22-26y) is less effective in lowering cancer risk"}}, {nodeId:"CONC040", properties:{label_zh:"结论", name:"CIN治疗后接种与降低病变复发风险相关", label_en:"Conclusion", name_en:"vaccination around CIN treatment is associated with lower risk of recurrence of lesions"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:结论;
UNWIND [{nodeId:"DIS001", properties:{label_zh:"疾病", name:"宫颈癌", label_en:"Disease", name_en:"cervical cancer"}}, {nodeId:"DIS003", properties:{label_zh:"疾病", name:"外阴癌", label_en:"Disease", name_en:"vulvar cancer"}}, {nodeId:"DIS005", properties:{label_zh:"疾病", name:"肛门癌", label_en:"Disease", name_en:"anal cancer"}}, {nodeId:"DIS006", properties:{label_zh:"疾病", name:"阴茎癌", label_en:"Disease", name_en:"penile cancer"}}, {nodeId:"DIS007", properties:{label_zh:"疾病", name:"头颈部恶性肿瘤（口咽鳞癌）", label_en:"Disease", name_en:"head and neck cancer (oropharyngeal carcinoma)"}}, {nodeId:"DIS008", properties:{label_zh:"疾病", name:"尖锐湿疣（生殖器疣）", label_en:"Disease", name_en:"genital warts (condyloma acuminatum)"}}, {nodeId:"DIS012", properties:{label_zh:"疾病", name:"HPV相关疾病（泛指）", label_en:"Disease", name_en:"HPV-related diseases"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:疾病;
UNWIND [{nodeId:"ORG01", properties:{label_zh:"组织机构", name:"中华医学会妇科肿瘤学分会", label_en:"Organization"}}, {nodeId:"ORG02", properties:{label_zh:"组织机构", name:"中华预防医学会疫苗与免疫分会", label_en:"Organization"}}, {nodeId:"ORG03", properties:{label_zh:"组织机构", name:"中国优生科学协会妇幼健康管理分会", label_en:"Organization"}}, {nodeId:"ORG04", properties:{label_zh:"组织机构", name:"中山大学附属第三医院岭南子宫颈癌防治专科联盟", label_en:"Organization"}}, {nodeId:"ORG05", properties:{label_zh:"组织机构", name:"接种单位", label_en:"Organization"}}, {nodeId:"ORG06", properties:{label_zh:"组织机构", org_type:"学会", name:"台湾感染症医学会(IDSTAIP)", label_en:"Organization", name_en:"Infectious Diseases Society of Taiwan (IDSTAIP)"}}, {nodeId:"ORG07", properties:{label_zh:"组织机构", org_type:"国际组织", name:"亚洲及大洋洲妇产科学会联合会(AOFOG)", label_en:"Organization", name_en:"Asia and Oceania Federation of Obstetrics and Gynecology (AOFOG)"}}, {nodeId:"ORG08", properties:{label_zh:"组织机构", name:"澳大利亚政府卫生部", org_type:"政府机构", label_en:"Organization", name_en:"Australian Government Department of Health"}}, {nodeId:"ORG09", properties:{label_zh:"组织机构", org_type:"政府机构", name:"加拿大国家免疫咨询委员会(NACI)", label_en:"Organization", name_en:"National Advisory Committee on Immunization (NACI)"}}, {nodeId:"ORG10", properties:{label_zh:"组织机构", name:"魁北克免疫委员会", org_type:"政府机构", label_en:"Organization", name_en:"Québec Immunization Committee"}}, {nodeId:"ORG11", properties:{label_zh:"组织机构", name:"韩国疾病管理厅(KDCA)", org_type:"政府机构", label_en:"Organization", name_en:"Korea Disease Control and Prevention Agency (KDCA)"}}, {nodeId:"ORG12", properties:{label_zh:"组织机构", org_type:"协会", name:"韩国泌尿生殖道感染与炎症协会(KAUTII)", label_en:"Organization", name_en:"Korean Association of Urogenital Tract Infection and Inflammation (KAUTII)"}}, {nodeId:"ORG13", properties:{label_zh:"组织机构", org_type:"学会", name:"韩国妇科肿瘤学会(KSGO)", label_en:"Organization", name_en:"Korean Society of Gynecologic Oncology (KSGO)"}}, {nodeId:"ORG14", properties:{label_zh:"组织机构", org_type:"政府机构", name:"英国疫苗接种与免疫联合委员会(JCVI)", label_en:"Organization", name_en:"Joint Committee on Vaccination and Immunisation (JCVI)"}}, {nodeId:"ORG15", properties:{label_zh:"组织机构", name:"波兰科学学会联合", org_type:"学会", label_en:"Organization", name_en:"Polish Scientific Societies"}}, {nodeId:"ORG16", properties:{label_zh:"组织机构", org_type:"学会", name:"爱尔兰皇家医师学院/国家免疫咨询委员会(NIAC)", label_en:"Organization", name_en:"Royal College of Physicians of Ireland / NIAC"}}, {nodeId:"ORG17", properties:{label_zh:"组织机构", name:"世界卫生组织(WHO)", org_type:"国际组织", label_en:"Organization", name_en:"World Health Organization (WHO)"}}, {nodeId:"ORG18", properties:{label_zh:"组织机构", org_type:"学会", name:"德国科学医学会联合工作组(AWMF)", label_en:"Organization", name_en:"Arbeitsgemeinschaft der Wissenschaftlichen Medizinischen Fachgesellschaften (AWMF)"}}, {nodeId:"ORG19", properties:{label_zh:"组织机构", org_type:"政府机构", name:"美国疾病控制与预防中心(CDC)", label_en:"Organization", name_en:"Centers for Disease Control and Prevention (CDC)"}}, {nodeId:"ORG20", properties:{label_zh:"组织机构", org_type:"政府机构", name:"美国国立癌症研究所(NCI)", label_en:"Organization", name_en:"National Cancer Institute (NCI)"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:组织机构;
UNWIND [{nodeId:"ORG21", properties:{label_zh:"组织机构", org_type:"学会", name:"美国妇产科医师学会(ACOG)", label_en:"Organization", name_en:"American College of Obstetricians and Gynecologists (ACOG)"}}, {nodeId:"ORG22", properties:{label_zh:"组织机构", name:"美国癌症协会(ACS)", org_type:"协会", label_en:"Organization", name_en:"American Cancer Society (ACS)"}}, {nodeId:"ORG23", properties:{label_zh:"组织机构", org_type:"政府机构", name:"美国免疫实施咨询委员会(ACIP)", label_en:"Organization", name_en:"Advisory Committee on Immunization Practices (ACIP)"}}, {nodeId:"ORG24", properties:{label_zh:"组织机构", org_type:"学会", name:"美国临床肿瘤学会(ASCO)", label_en:"Organization", name_en:"American Society of Clinical Oncology (ASCO)"}}, {nodeId:"ORG25", properties:{label_zh:"组织机构", org_type:"国际组织", name:"欧洲妇产科委员会与学院(EBCOG)", label_en:"Organization", name_en:"European Board and College of Obstetrics and Gynaecology (EBCOG)"}}, {nodeId:"ORG26", properties:{label_zh:"组织机构", org_type:"学会", name:"欧洲妇科肿瘤学会(ESGO)", label_en:"Organization", name_en:"European Society of Gynaecologic Oncology (ESGO)"}}, {nodeId:"ORG27", properties:{label_zh:"组织机构", org_type:"学会", name:"欧洲阴道镜联合会(EFC)", label_en:"Organization", name_en:"European Federation for Colposcopy (EFC)"}}, {nodeId:"ORG28", properties:{label_zh:"组织机构", org_type:"学会", name:"意大利阴道镜与宫颈阴道病理学会(SICPCV)", label_en:"Organization", name_en:"Italian Society of Colposcopy and Cervico-Vaginal Pathology (SICPCV)"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:组织机构;
UNWIND [{nodeId:"SCR001", properties:{label_zh:"筛查/诊断措施", name:"外阴检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR002", properties:{label_zh:"筛查/诊断措施", name:"外阴自检", label_en:"ScreeningMeasure"}}, {nodeId:"SCR003", properties:{label_zh:"筛查/诊断措施", name:"阴道镜检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR004", properties:{label_zh:"筛查/诊断措施", name:"HPV联合细胞学检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR005", properties:{label_zh:"筛查/诊断措施", name:"组织病理学活检", label_en:"ScreeningMeasure"}}, {nodeId:"SCR006", properties:{label_zh:"筛查/诊断措施", name:"肛门细胞学检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR007", properties:{label_zh:"筛查/诊断措施", name:"HPV检测", label_en:"ScreeningMeasure"}}, {nodeId:"SCR008", properties:{label_zh:"筛查/诊断措施", name:"高分辨率肛门镜检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR009", properties:{label_zh:"筛查/诊断措施", name:"内镜检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR010", properties:{label_zh:"筛查/诊断措施", name:"软性咽喉内镜检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR011", properties:{label_zh:"筛查/诊断措施", name:"宫颈癌筛查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR012", properties:{label_zh:"筛查/诊断措施", name:"病理学评估（HPV感染状态）", label_en:"ScreeningMeasure"}}, {nodeId:"SCR013", properties:{label_zh:"筛查/诊断措施", name:"辅助检查", label_en:"ScreeningMeasure"}}, {nodeId:"SCR018", properties:{label_zh:"筛查/诊断措施", name:"HPV感染及相关癌症筛查与监测", label_en:"ScreeningMeasure", name_en:"HPV infection and associated cancer screening and surveillance"}}, {nodeId:"SCR019", properties:{label_zh:"筛查/诊断措施", name:"验证的HPV检测（自采样或医师采样）", label_en:"ScreeningMeasure", name_en:"validated HPV DNA NAATs on self- or provider-collected samples"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:`筛查/诊断措施`;
