UNWIND [{nodeId:"COND101", properties:{label_zh:"条件", name:"与基础设施/冷链兼容、可负担、可持续、实现最高覆盖", label_en:"Condition", name_en:"compatible with delivery infrastructure and cold chain, affordable, sustainable, highest coverage"}}, {nodeId:"COND102", properties:{label_zh:"条件", name:"剂次间无最长间隔限制（可长达3-5年）", label_en:"Condition", name_en:"no maximum interval; intervals up to 3-5 years can be considered"}}, {nodeId:"COND103", properties:{label_zh:"条件", name:"考虑疾病负担、许可人群、产品特性（含单剂效力数据）、价格与项目因素", label_en:"Condition", name_en:"based on disease burden, licensed population, product characteristics, price, programme considerations"}}, {nodeId:"COND104", properties:{label_zh:"条件", name:"单剂次方案须选用有效力或免疫桥接数据的疫苗", label_en:"Condition", name_en:"single-dose schedules: vaccines with efficacy or immunobridging data advised"}}, {nodeId:"COND105", properties:{label_zh:"条件", name:"多剂次程序应尽量使用同一疫苗完成", label_en:"Condition", name_en:"the same vaccine should be used for all doses of a multidose schedule"}}, {nodeId:"COND106", properties:{label_zh:"条件", name:"哺乳期不是接种禁忌", label_en:"Condition", name_en:"breastfeeding is not a contraindication"}}, {nodeId:"COND107", properties:{label_zh:"条件", name:"纳入国家免疫数据报告系统、登记与定期调查", label_en:"Condition", name_en:"included in national immunization data reporting systems, registries, periodic surveys"}}, {nodeId:"COND108", properties:{label_zh:"条件", name:"研究优先：单剂次长期证据、免疫受损者减剂方案、提高接种率实施研究", label_en:"Condition", name_en:"research priorities: long-term single-dose evidence, reduced-dose schedules in immunocompromised, implementation research"}}, {nodeId:"COND109", properties:{label_zh:"条件", name:"各疫苗许可年龄上限为26或45岁（因产品而异）", label_en:"Condition", name_en:"licensed up to 26 or 45 years depending on product"}}, {nodeId:"COND110", properties:{label_zh:"条件", name:"两剂间隔<5个月需补种第3剂", label_en:"Condition", name_en:"two doses less than 5 months apart require a third dose"}}, {nodeId:"COND111", properties:{label_zh:"条件", name:"接种时坐位或平卧位并观察15分钟", label_en:"Condition", name_en:"seated or lying down during vaccination and for 15 minutes after"}}, {nodeId:"COND112", properties:{label_zh:"条件", name:"与其他疫苗（如MenACWY、Tdap）同时接种时在对侧肢体注射", label_en:"Condition", name_en:"given in the opposite limb when co-administered (e.g., MenACWY, Tdap)"}}, {nodeId:"COND113", properties:{label_zh:"条件", name:"可与其他疫苗同时或以任意间隔接种", label_en:"Condition", name_en:"can be administered concurrently or at any interval with other vaccines"}}, {nodeId:"COND114", properties:{label_zh:"条件", name:"接种后观察30分钟（坐卧位、饮品点心防晕厥）", label_en:"Condition", name_en:"observe 30 minutes after vaccination; sitting/lying, drink, snack to prevent syncope"}}, {nodeId:"COND115", properties:{label_zh:"条件", name:"已完成全程接种者", label_en:"Condition", name_en:"after a complete vaccination series"}}, {nodeId:"COND116", properties:{label_zh:"条件", name:"无论HPV接种状态（筛查）", label_en:"Condition", name_en:"irrespective of HPV vaccination status (screening)"}}, {nodeId:"COND117", properties:{label_zh:"条件", name:"尤其建议至26岁（免疫受损成人）", label_en:"Condition", name_en:"especially until the age of 26 years (immunocompromised adults)"}}, {nodeId:"COND118", properties:{label_zh:"条件", name:"受限资源环境（limited resource settings）", label_en:"Condition", name_en:"limited resource settings"}}, {nodeId:"COND119", properties:{label_zh:"条件", name:"26岁以上成人不予常规补种", label_en:"Condition", name_en:"catch-up vaccination not recommended for all adults aged >26 years"}}] AS row
