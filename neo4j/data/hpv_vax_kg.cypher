d guidance on human papillomavirus (HPV) vaccines", name_en:"Summary of the National Advisory Committee on Immunization (NACI) Statement: Updated guidance on human papillomavirus (HPV) vaccines"}}, {nodeId:"G09", properties:{country:"加拿大", label_zh:"文献资料", year:2024, name:"Archived: Updated Recommendations on Human Papillomavirus (HPV) Vaccines: 9-valent HPV vaccine 2-dose immunization schedule and the use of HPV vaccines in immunocompromised populations", label_en:"Guideline", title:"Archived: Updated Recommendations on Human Papillomavirus (HPV) Vaccines: 9-valent HPV vaccine 2-dose immunization schedule and the use of HPV vaccines in immunocompromised populations", name_en:"Archived: Updated Recommendations on Human Papillomavirus (HPV) Vaccines: 9-valent HPV vaccine 2-dose immunization schedule and the use of HPV vaccines in immunocompromised populations"}}, {nodeId:"G10", properties:{country:"加拿大", label_zh:"文献资料", year:2016, name:"HPV Vaccination for MSM: Synthesis of the evidence and recommendations from the Québec Immunization Committee", label_en:"Guideline", title:"HPV Vaccination for MSM: Synthesis of the evidence and recommendations from the Québec Immunization Committee", name_en:"HPV Vaccination for MSM: Synthesis of the evidence and recommendations from the Québec Immunization Committee"}}, {nodeId:"G11", properties:{country:"韩国", label_zh:"文献资料", year:2024, name:"2023 Korean sexually transmitted infections guidelines by the Korean Association of Urogenital Tract Infection and Inflammation: Human papillomavirus vaccination", label_en:"Guideline", title:"2023 Korean sexually transmitted infections guidelines by the Korean Association of Urogenital Tract Infection and Inflammation: Human papillomavirus vaccination", name_en:"2023 Korean sexually transmitted infections guidelines by the Korean Association of Urogenital Tract Infection and Inflammation: Human papillomavirus vaccination"}}, {nodeId:"G12", properties:{country:"韩国", label_zh:"文献资料", year:2021, name:"Updated clinical guideline for human papillomavirus vaccine: the Korean Society of Gynecologic Oncology guidelines", label_en:"Guideline", title:"Updated clinical guideline for human papillomavirus vaccine: the Korean Society of Gynecologic Oncology guidelines", name_en:"Updated clinical guideline for human papillomavirus vaccine: the Korean Society of Gynecologic Oncology guidelines"}}, {nodeId:"G13", properties:{country:"英国", label_zh:"文献资料", year:2023, name:"HPV vaccination guidance for healthcare practitioners (JCVI)", label_en:"Guideline", title:"HPV vaccination guidance for healthcare practitioners (JCVI)", name_en:"HPV vaccination guidance for healthcare practitioners (JCVI)"}}, {nodeId:"G14", properties:{country:"波兰", label_zh:"文献资料", year:2022, name:"Recommendations on prophylactic vaccinations against infections with human papillomaviruses in Poland", label_en:"Guideline", title:"Recommendations on prophylactic vaccinations against infections with human papillomaviruses in Poland", name_en:"Recommendations on prophylactic vaccinations against infections with human papillomaviruses in Poland"}}, {nodeId:"G15", properties:{country:"爱尔兰", label_zh:"文献资料", year:2023, name:"Immunisation Guidelines for Ireland: Chapter 10 Human Papillomavirus", label_en:"Guideline", title:"Immunisation Guidelines for Ireland: Chapter 10 Human Papillomavirus", name_en:"Immunisation Guidelines for Ireland: Chapter 10 Human Papillomavirus"}}, {nodeId:"G16", properties:{country:"国际组织(WHO)", label_zh:"文献资料", year:2022, name:"Human papillomavirus vaccines: WHO position paper", label_en:"Guideline", title:"Human papillomavirus vaccines: WHO position paper", name_en:"Human papillomavirus vaccines: WHO position paper"}}, {nodeId:"G17", properties:{country:"德国", label_zh:"文献资料", year:2021, name:"German evidence and consensus-based (S3) guideline: Vaccination recommendations for the prevention of HPV-associated lesions", label_en:"Guideline", title:"German evidence and consensus-based (S3) guideline: Vaccination recommendations for the prevention of HPV-associated lesions", name_en:"German evidence and consensus-based (S3) guideline: Vaccination recommendations for the prevention of HPV-associated lesions"}}, {nodeId:"G18", properties:{country:"美国", label_zh:"文献资料", year:2021, name:"Human Papillomavirus (HPV) Vaccination: Information for Health Care Providers (CDC)", label_en:"Guideline", title:"Human Papillomavirus (HPV) Vaccination: Information for Health Care Providers (CDC)", name_en:"Human Papillomavirus (HPV) Vaccination: Information for Health Care Providers (CDC)"}}, {nodeId:"G19", properties:{country:"美国", label_zh:"文献资料", year:2021, name:"Human Papillomavirus (HPV) Vaccines (NCI)", label_en:"Guideline", title:"Human Papillomavirus (HPV) Vaccines (NCI)", name_en:"Human Papillomavirus (HPV) Vaccines (NCI)"}}, {nodeId:"G20", properties:{country:"美国", label_zh:"文献资料", year:2020, name:"Human Papillomavirus Vaccination: ACOG Committee Opinion", label_en:"Guideline", title:"Human Papillomavirus Vaccination: ACOG Committee Opinion", name_en:"Human Papillomavirus Vaccination: ACOG Committee Opinion"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:文献资料;
UNWIND [{nodeId:"G21", properties:{country:"美国", label_zh:"文献资料", year:2020, name:"Human Papillomavirus Vaccination 2020 Guideline Update: American Cancer Society Guideline Adaptation", label_en:"Guideline", title:"Human Papillomavirus Vaccination 2020 Guideline Update: American Cancer Society Guideline Adaptation", name_en:"Human Papillomavirus Vaccination 2020 Guideline Update: American Cancer Society Guideline Adaptation"}}, {nodeId:"G22", properties:{country:"美国", label_zh:"文献资料", year:2020, name:"HPV Vaccination for Adults: Updated Recommendations of the Advisory Committee on Immunization Practices", label_en:"Guideline", title:"HPV Vaccination for Adults: Updated Recommendations of the Advisory Committee on Immunization Practices", name_en:"HPV Vaccination for Adults: Updated Recommendations of the Advisory Committee on Immunization Practices"}}, {nodeId:"G23", properties:{country:"美国", label_zh:"文献资料", year:2017, name:"Primary Prevention of Cervical Cancer: American Society of Clinical Oncology Resource-Stratified Guideline", label_en:"Guideline", title:"Primary Prevention of Cervical Cancer: American Society of Clinical Oncology Resource-Stratified Guideline", name_en:"Primary Prevention of Cervical Cancer: American Society of Clinical Oncology Resource-Stratified Guideline"}}, {nodeId:"G24", properties:{country:"欧洲", label_zh:"文献资料", year:2020, name:"EBCOG position statement: Gender neutral HPV vaccination for young adults", label_en:"Guideline", title:"EBCOG position statement: Gender neutral HPV vaccination for young adults", name_en:"EBCOG position statement: Gender neutral HPV vaccination for young adults"}}, {nodeId:"G25", properties:{country:"欧洲", label_zh:"文献资料", year:2019, name:"Human papillomavirus vaccination: The ESGO-EFC position paper of the European Society of Gynaecologic Oncology and the European Federation for Colposcopy", label_en:"Guideline", title:"Human papillomavirus vaccination: The ESGO-EFC position paper of the European Society of Gynaecologic Oncology and the European Federation for Colposcopy", name_en:"Human papillomavirus vaccination: The ESGO-EFC position paper of the European Society of Gynaecologic Oncology and the European Federation for Colposcopy"}}, {nodeId:"G26", properties:{country:"意大利", label_zh:"文献资料", year:2020, name:"HPV Vaccination: The Position Paper of the Italian Society of Colposcopy and Cervico-Vaginal Pathology (SICPCV)", label_en:"Guideline", title:"HPV Vaccination: The Position Paper of the Italian Society of Colposcopy and Cervico-Vaginal Pathology (SICPCV)", name_en:"HPV Vaccination: The Position Paper of the Italian Society of Colposcopy and Cervico-Vaginal Pathology (SICPCV)"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:文献资料;
UNWIND [{nodeId:"G01-R01", properties:{label_zh:"推荐意见", original_grade:"1类", grade_system:"G01分类", name:"优先推荐9-26岁女性接种HPV疫苗，重点是9-14岁女孩。", label_en:"Recommendation"}}, {nodeId:"G01-R02", properties:{label_zh:"推荐意见", original_grade:"2A类", grade_system:"G01分类", name:"推荐27-45岁有条件的女性接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G01-R03", properties:{label_zh:"推荐意见", original_grade:"2A类", grade_system:"G01分类", name:"推荐9-26岁男性接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G01-R04", properties:{label_zh:"推荐意见", original_grade:"2A类", grade_system:"G01分类", name:"无论是否存在HPV感染或细胞学异常，推荐适龄女性接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G01-R05", properties:{label_zh:"推荐意见", original_grade:"2A类", grade_system:"G01分类", name:"推荐子宫颈癌前病变的适龄女性，在治疗前或治疗后尽早接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G01-R06", properties:{label_zh:"推荐意见", original_grade:"2B类", grade_system:"G01分类", name:"推荐既往外阴、阴道癌前病变/癌治疗史、肛门癌高风险人群（包括HIV阳性和MSM）、AGW和RRP人群，尽早接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G01-R07", properties:{label_zh:"推荐意见", original_grade:"2B类", grade_system:"G01分类", name:"推荐遗传易感位点变异的适龄女性（HLA-DPB2、EXOC1和GSDMB基因突变等）接种HPV疫苗。建议遗传易感人群在首次性行为之前接种，即使性暴露后亦应尽早接种。", label_en:"Recommendation"}}, {nodeId:"G01-R08", properties:{label_zh:"推荐意见", original_grade:"2A类", grade_system:"G01分类", name:"优先推荐子宫颈癌发病高风险生活方式的适龄女性尽早接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G01-R09", properties:{label_zh:"推荐意见", original_grade:"2A类", grade_system:"G01分类", name:"优先推荐HIV感染的适龄女性人群接种HPV疫苗，最好在性行为之前接种。", label_en:"Recommendation"}}, {nodeId:"G01-R10", properties:{label_zh:"推荐意见", original_grade:"2A类", grade_system:"G01分类", name:"推荐患有自身免疫性疾病的适龄人群接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G01-R11", properties:{label_zh:"推荐意见", original_grade:"2B类", grade_system:"G01分类", name:"对于糖尿病、肾衰竭接受血液透析的适龄人群，建议临床医生与患者共同探讨，在病情允许时接种HPV疫苗。对全身脏器功能差、预期寿命有限者不推荐接种。", label_en:"Recommendation"}}, {nodeId:"G01-R12", properties:{label_zh:"推荐意见", original_grade:"2B类", grade_system:"G01分类", name:"对于器官或骨髓移植后长期服用免疫抑制剂或恶性肿瘤患者，建议临床医生与患者共同探讨，根据疾病轻重差别给予个体化建议，对于预期寿命长的适龄女性，推荐移植1年后接种HPV疫苗；对于预期寿命有限者，不推荐接种。", label_en:"Recommendation"}}, {nodeId:"G01-R13", properties:{label_zh:"推荐意见", original_grade:"-", grade_system:"G01分类", name:"不推荐妊娠期女性预防性接种HPV疫苗。若接种后发现妊娠，应将未完成接种剂次推迟至分娩后再行接种；已完成接种者，无需干预。", label_en:"Recommendation"}}, {nodeId:"G01-R14", properties:{label_zh:"推荐意见", original_grade:"-", grade_system:"G01分类", name:"慎重推荐哺乳期女性接种HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G02-R01", properties:{label_zh:"推荐意见", original_grade:"A级证据，强推荐", grade_system:"GRADE", name:"对具有外阴癌和阴道癌高危因素的女性加强健康教育，包括自检方式、健康生活方式以及安全性行为教育，同时应重视其性伴侣的安全性行为教育；推荐无接种禁忌证的适龄女性尽早接种HPV疫苗，在预防宫颈癌的同时预防HPV相关外阴/阴道癌及癌前病变。", label_en:"Recommendation"}}, {nodeId:"G02-R02", properties:{label_zh:"推荐意见", original_grade:"B级证据，强推荐", grade_system:"GRADE", name:"推荐行常规宫颈癌筛查时行常规外阴检查，对外阴癌高危人群推荐自检，已确诊宫颈、肛门部位鳞状上皮内病变的女性在阴道镜检查中应常规检查外阴部位。", label_en:"Recommendation"}}, {nodeId:"G02-R03", properties:{label_zh:"推荐意见", original_grade:"C级证据，弱推荐", grade_system:"GRADE", name:"推荐行常规宫颈癌筛查时同时加强阴道检查，有阴道癌筛查指征的人群应定期进行HPV联合细胞学检查。", label_en:"Recommendation"}}, {nodeId:"G02-R04", properties:{label_zh:"推荐意见", original_grade:"B级证据，强推荐", grade_system:"GRADE", name:"推荐对具有阴茎癌高危因素的男性加强健康教育，包括包茎患者行包皮环切术、健康生活方式、安全性行为教育、注意局部卫生等；推荐无接种禁忌证的适龄男性接种HPV疫苗以预防HPV相关阴茎癌。", label_en:"Recommendation"}}, {nodeId:"G02-R05", properties:{label_zh:"推荐意见", original_grade:"C级证据，弱推荐", grade_system:"GRADE", name:"推荐可疑的阴茎病变应进行组织病理学活检，病理学评估应包括对HPV感染状态的评估。", label_en:"Recommendation"}}, {nodeId:"G02-R06", properties:{label_zh:"推荐意见", original_grade:"A级证据，强推荐", grade_system:"GRADE", name:"对具有肛门癌高危因素的人群加强健康教育，倡导其通过科学使用安全套、避免高危性行为、戒烟、戒酒、合理膳食等方式预防肛门癌；推荐无接种禁忌证的适龄人群通过接种HPV疫苗预防HPV相关肛门癌、AIN和肛门部位HPV感染。", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G02-R07", properties:{label_zh:"推荐意见", original_grade:"B级证据，弱推荐", grade_system:"GRADE", name:"针对肛门癌高危人群推荐采用肛门细胞学和（或）HPV检测进行筛查，细胞学异常、HPV-16或18型阳性、临床可疑肛门癌前病变者转诊高分辨率肛门镜检查。", label_en:"Recommendation"}}, {nodeId:"G02-R08", properties:{label_zh:"推荐意见", original_grade:"A级证据，强推荐", grade_system:"GRADE", name:"推荐对具有头颈部恶性肿瘤高危因素的人群加强健康教育，倡导其戒烟、戒酒、戒槟榔、尽量避免口交性行为；推荐无接种禁忌证的适龄人群通过接种HPV疫苗预防口腔HPV感染及相关口咽鳞状细胞癌。", label_en:"Recommendation"}}, {nodeId:"G02-R09", properties:{label_zh:"推荐意见", original_grade:"B级证据，强推荐", grade_system:"GRADE", name:"推荐使用内镜检查等影像学检查技术实现头颈部恶性肿瘤的早期诊断。", label_en:"Recommendation"}}, {nodeId:"G02-R10", properties:{label_zh:"推荐意见", original_grade:"A级证据，强推荐", grade_system:"GRADE", name:"对尖锐湿疣高危人群加强健康教育，倡导其进行安全性行为、注意个人卫生等方式预防尖锐湿疣；推荐无接种禁忌证的适龄人群尽早接种HPV疫苗预防尖锐湿疣。", label_en:"Recommendation"}}, {nodeId:"G02-R11", properties:{label_zh:"推荐意见", original_grade:"C级证据，弱推荐", grade_system:"GRADE", name:"推荐尖锐湿疣高危人群定期评估疾病发生风险，若出现不典型皮损和特殊部位的皮损，可结合辅助检查进行诊断。", label_en:"Recommendation"}}, {nodeId:"G02-R12", properties:{label_zh:"推荐意见", original_grade:"C级证据，弱推荐", grade_system:"GRADE", name:"对儿童RRP高危人群的父母及家庭成员加强健康教育，倡导父母进行安全性行为、加强孕产期保健等，同时鼓励家庭成员注意保持良好卫生行为以预防儿童发生RRP；对成年RRP高危人群加强健康教育，倡导其进行安全性行为、保持健康生活方式以预防RRP；推荐无接种禁忌证的适龄人群接种HPV疫苗以降低其子女发生RRP的风险。", label_en:"Recommendation"}}, {nodeId:"G02-R13", properties:{label_zh:"推荐意见", original_grade:"A级证据，强推荐", grade_system:"GRADE", name:"对于有声音嘶哑等症状的儿童需重点关注，如存在喘鸣、喉梗阻或呼吸困难，可在生命体征平稳时，推荐结合临床具体情况选择性进行软性咽喉内镜检查。", label_en:"Recommendation"}}, {nodeId:"G03-R01", properties:{label_zh:"推荐意见", original_grade:"A级", grade_system:"G03简化分级", name:"推荐女性儿童和青少年接种2价、4价或9价HPV疫苗；男性儿童和青少年接种4价或9价HPV疫苗。", label_en:"Recommendation"}}, {nodeId:"G03-R02", properties:{label_zh:"推荐意见", original_grade:"A级", grade_system:"G03简化分级", name:"无论男性或女性儿童和青少年均建议在9-14岁常规接种HPV疫苗。如14岁前未接种的儿童和青少年，建议在26岁前应完成HPV疫苗接种。", label_en:"Recommendation"}}, {nodeId:"G03-R03", properties:{label_zh:"推荐意见", original_grade:"A级", grade_system:"G03简化分级", name:"推荐健康男女儿童或青少年应在9-14岁启动2剂次HPV疫苗接种。", label_en:"Recommendation"}}, {nodeId:"G03-R04", properties:{label_zh:"推荐意见", original_grade:"B级", grade_system:"G03简化分级", name:"第1剂次HPV疫苗接种的年龄决定疫苗总的接种剂次。", label_en:"Recommendation"}}, {nodeId:"G03-R05", properties:{label_zh:"推荐意见", original_grade:"A级", grade_system:"G03简化分级", name:"第2剂次HPV疫苗建议与第1剂次接种间隔时间为6个月（即0月和6个月）；如特殊原因需要缩短接种间隔时间，建议至少间隔5个月，过早接种第2剂次HPV疫苗时需再次接种，再次接种的时间至少应在第1剂次接种5个月后接种。", label_en:"Recommendation"}}, {nodeId:"G03-R06", properties:{label_zh:"推荐意见", original_grade:"C级", grade_system:"G03简化分级", name:"免疫功能损害的儿童和青少年患者，如人类免疫缺陷病毒（HIV）感染、恶性肿瘤、自身免疫性疾病（AID）、器官移植受者或接受免疫抑制治疗等，推荐3剂次HPV疫苗接种，并建议选择9价HPV疫苗接种。", label_en:"Recommendation"}}, {nodeId:"G03-R07", properties:{label_zh:"推荐意见", original_grade:"A级", grade_system:"G03简化分级", name:"3剂次推荐接种安排分别为0月、6个月和12个月。建议最短接种间隔时间：第1剂次和第2剂次至少需间隔4周，第2剂次与第3剂次至少需间隔16周；或第1剂次和第3剂次间隔时间必须≥5个月；所有3剂次接种均应在1年内完成。", label_en:"Recommendation"}}, {nodeId:"G03-R08", properties:{label_zh:"推荐意见", original_grade:"B级", grade_system:"G03简化分级", name:"15岁前已完成2价或4价HPV疫苗接种的儿童和青少年，可确认已完成了HPV疫苗的接种程序。", label_en:"Recommendation"}}, {nodeId:"G03-R09", properties:{label_zh:"推荐意见", original_grade:"A级", grade_system:"G03简化分级", name:"4价HPV疫苗可显著降低感染率，但疫苗仍需更广泛覆盖常见感染的HPV亚型，推荐接种9价疫苗或更高价的疫苗是必然趋势。", label_en:"Recommendation"}}, {nodeId:"G03-R10", properties:{label_zh:"推荐意见", original_grade:"C级", grade_system:"G03简化分级", name:"目前单剂次HPV疫苗接种方案仍属超说明书使用方案，WHO认为单剂次HPV疫苗可用于9-20岁男女儿童和青少年。单剂次HPV疫苗接种可能有助于提高接种的覆盖率和缓解中低收入国家和地区疫苗的可及性。", label_en:"Recommendation"}}, {nodeId:"G03-R11", properties:{label_zh:"推荐意见", original_grade:"A级", grade_system:"G03简化分级", name:"推荐我国男性儿童和青少年HPV疫苗接种。", label_en:"Recommendation"}}, {nodeId:"G04-R01", properties:{label_zh:"推荐意见", original_grade:"-", grade_system:"G04无分级", name:"HPV疫苗安全性的主要影响因素是抗原、佐剂以及稳定剂等非活性辅料成分及其剂量。", label_en:"Recommendation"}}, {nodeId:"G04-R02", properties:{label_zh:"推荐意见", original_grade:"-", grade_system:"G04无分级", name:"我国目前上市的HPV疫苗总体安全性良好，各款疫苗之间的不良反应有一定的差异，但多数是轻症，在健康女性中具有良好的耐受性。", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G04-R03", properties:{label_zh:"推荐意见", original_grade:"-", grade_system:"G04无分级", name:"HPV疫苗在妊娠期应避免接种，哺乳期谨慎接种。", label_en:"Recommendation"}}, {nodeId:"G04-R04", properties:{label_zh:"推荐意见", original_grade:"-", grade_system:"G04无分级", name:"疑似预防接种异常反应主要是一般反应，需紧急处理的异常反应并不多见，但接种单位必须做好应急处理预案，保障受种者安全。", label_en:"Recommendation"}}, {nodeId:"G04-R05", properties:{label_zh:"推荐意见", original_grade:"-", grade_system:"G04无分级", name:"HPV疫苗与其他疫苗同时接种是安全的。", label_en:"Recommendation"}}, {nodeId:"G05-R01", properties:{label_zh:"推荐意见", original_grade:"Strong/High (1 A)", grade_system:"GRADE", name:"Adult women through age 26 years: HPV vaccination (primary series). HPV vaccination is recommended for all women through age 26 years who are not adequately vaccinated.", label_en:"Recommendation"}}, {nodeId:"G05-R02", properties:{label_zh:"推荐意见", original_grade:"Weak/Moderate (2 B)", grade_system:"GRADE", name:"Adult women aged 27 through 45 years: Catch-up HPV vaccination through shared decision-making. 9vHPV vaccine shows non-inferior immunogenicity; 4vHPV prevents CIN or genital warts from vaccine-type virus for up to a decade; 2vHPV exhibits 90.5% efficacy in reducing persistent infection, any CIN, or external genital lesions; all three vaccines are generally well-tolerated.", label_en:"Recommendation"}}, {nodeId:"G05-R03", properties:{label_zh:"推荐意见", original_grade:"Strong/High (1A)", grade_system:"GRADE", name:"Adult men through age 26 years: HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G05-R04", properties:{label_zh:"推荐意见", original_grade:"Weak/Very Low (2D)", grade_system:"GRADE", name:"Adult men aged 27 through 45 years: Catch-up HPV vaccination through shared decision-making. No randomized controlled trial of HPV vaccination for adult males aged 27 through 45 years.", label_en:"Recommendation"}}, {nodeId:"G05-R05", properties:{label_zh:"推荐意见", original_grade:"Strong/Moderate (1B)", grade_system:"GRADE", name:"People with HIV: HPV vaccination. Deferring vaccination until receiving antiretroviral therapy and virologically suppressed with CD4 counts ≥200 cells/mm3.", label_en:"Recommendation"}}, {nodeId:"G05-R06", properties:{label_zh:"推荐意见", original_grade:"Weak/Very low (2D)", grade_system:"GRADE", name:"Transplant recipients: HPV vaccination. Before transplantation or at least one year post-transplantation.", label_en:"Recommendation"}}, {nodeId:"G05-R07", properties:{label_zh:"推荐意见", original_grade:"Weak/Very low (2D)", grade_system:"GRADE", name:"Autoimmune inflammatory rheumatic diseases: HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G05-R08", properties:{label_zh:"推荐意见", original_grade:"Weak/Moderate (2 B)", grade_system:"GRADE", name:"Oropharyngeal HPV infection, adults through age 45 years: HPV vaccination. The current recommendation relies on 2vHPV and 4vHPV vaccines for females aged 15-26 and people with HIV. Research is ongoing for the efficacy of 9vHPV against oral HPV infections.", label_en:"Recommendation"}}, {nodeId:"G05-R09", properties:{label_zh:"推荐意见", original_grade:"Weak/Very low (2D)", grade_system:"GRADE", name:"Oropharyngeal cancer, adults through age 45 years: HPV vaccination. Limited evidence currently supports the use of HPV vaccination to reduce oropharyngeal cancer incidence; the panel recommends that individuals through 45 years receive HPV vaccination to prevent oropharyngeal cancer.", label_en:"Recommendation"}}, {nodeId:"G05-R10", properties:{label_zh:"推荐意见", original_grade:"Strong/High (1 A)", grade_system:"GRADE", name:"Dosing schedule, all adults: 3-dose schedule HPV vaccination at 0, 1-2, 6 months. The recommendation is derived from evidence obtained from randomized controlled trials. Less frequent dosing schedules (1-dose and 2-dose) showed promising results in post-hoc analyses of previous trials, but real-world data showed discrepant results.", label_en:"Recommendation"}}, {nodeId:"G05-R11", properties:{label_zh:"推荐意见", original_grade:"Expert opinion", grade_system:"GRADE", name:"Heterologous vaccination regimen: 9vHPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G05-R12", properties:{label_zh:"推荐意见", original_grade:"Weak/Low (2C)", grade_system:"GRADE", name:"Adults who have completed 4vHPV or 2vHPV vaccination series: No recommendation for additional 9vHPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G06-R01", properties:{label_zh:"推荐意见", name:"Target group: Standard (minimum) - Girls aged 9-14 years; Standard (preferred) - Females and males 9-26 years, and considering vaccination up to 45 years.", label_en:"Recommendation"}}, {nodeId:"G06-R02", properties:{label_zh:"推荐意见", name:"Doses of vaccines, 9-14 years: Standard (minimum) - 1 dose; Standard (preferred) - 1 or 2 dose(s).", label_en:"Recommendation"}}, {nodeId:"G06-R03", properties:{label_zh:"推荐意见", name:"Doses of vaccines, 15-20 years: Standard (minimum) - 1 dose; Standard (preferred) - 1 or 2 dose(s).", label_en:"Recommendation"}}, {nodeId:"G06-R04", properties:{label_zh:"推荐意见", name:"Doses of vaccines, ≥21 years: 2 doses.", label_en:"Recommendation"}}, {nodeId:"G06-R05", properties:{label_zh:"推荐意见", name:"Doses of vaccines: Not routine after 26 years old.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G06-R06", properties:{label_zh:"推荐意见", name:"Types of vaccines: Standard (minimum) - Bivalent/quadrivalent (must undergo Phase 3 trials); Standard (preferred) - Nonavalent.", label_en:"Recommendation"}}, {nodeId:"G06-R07", properties:{label_zh:"推荐意见", name:"Special populations - Those with previous HPV-related diseases with/without treatment: Not mandatory for vaccination (minimum); Allowed for vaccination upon thorough counseling (preferred).", label_en:"Recommendation"}}, {nodeId:"G06-R08", properties:{label_zh:"推荐意见", name:"Special populations - HIV patients: Standard (minimum) - 2 doses; Standard (preferred) - 3 doses.", label_en:"Recommendation"}}, {nodeId:"G06-R09", properties:{label_zh:"推荐意见", name:"Special populations - LGBTA: Standard (minimum) - 2 doses; Standard (preferred) - 3 doses.", label_en:"Recommendation"}}, {nodeId:"G06-R10", properties:{label_zh:"推荐意见", name:"Inter-changeability and changeability and booster: Cross-over from 2vHPV or 4vHPV to 9vHPV is allowed to complete the recommended doses of vaccine. Routine booster and/or revaccination after completion of vaccination with 2vHPV or 4vHPV is not necessary.", label_en:"Recommendation"}}, {nodeId:"G06-R11", properties:{label_zh:"推荐意见", name:"Novel technologies/vaccines: Need further research; involve LMIC countries.", label_en:"Recommendation"}}, {nodeId:"G06-R12", properties:{label_zh:"推荐意见", name:"Public education: Need public education including information on cervical screening and life-style modification.", label_en:"Recommendation"}}, {nodeId:"G07-R01", properties:{label_zh:"推荐意见", name:"Adolescents and young adults are recommended to receive HPV vaccine from 9 years of age and onwards.", label_en:"Recommendation"}}, {nodeId:"G07-R02", properties:{label_zh:"推荐意见", name:"The optimal age for HPV vaccination is around 12-13 years prior to exposure to HPV.", label_en:"Recommendation"}}, {nodeId:"G07-R03", properties:{label_zh:"推荐意见", name:"People who have not received HPV vaccine by 14 years of age can still receive the vaccine up to 25 years of age.", label_en:"Recommendation"}}, {nodeId:"G07-R04", properties:{label_zh:"推荐意见", name:"The recommended schedule for adolescents and young adults aged 9-25 years is 1 dose.", label_en:"Recommendation"}}, {nodeId:"G07-R05", properties:{label_zh:"推荐意见", name:"People with immunocompromising conditions need 3 doses of HPV vaccine, regardless of their age.", label_en:"Recommendation"}}, {nodeId:"G07-R06", properties:{label_zh:"推荐意见", name:"HPV vaccine is funded through the NIP for adolescents and young adults from 12 to 25 years of age, which is usually given to adolescents in School Year 7 (approximately 12-13 years).", label_en:"Recommendation"}}, {nodeId:"G07-R07", properties:{label_zh:"推荐意见", name:"HPV vaccine may be considered in children aged <9 years who are at risk of exposure to HPV (for example, have a history of sexual abuse or have been diagnosed with a sexually transmitted infection).", label_en:"Recommendation"}}, {nodeId:"G07-R08", properties:{label_zh:"推荐意见", name:"A subsequent dose should be given as routinely recommended at age ≥9 years, ideally at age 12-13 years.", label_en:"Recommendation"}}, {nodeId:"G07-R09", properties:{label_zh:"推荐意见", name:"Women who have received HPV vaccine are recommended to undergo cervical screening through the National Cervical Screening Program. HPV types other than those included in the HPV vaccines can cause cervical cancer. Therefore, both cervical screening and HPV vaccination are recommended. Healthcare providers should check on the need for catch-up vaccination at the first cervical screening visit, which should occur at age 25 years.", label_en:"Recommendation"}}, {nodeId:"G07-R10", properties:{label_zh:"推荐意见", name:"Adults aged ≥26 years are not routinely recommended to receive HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G07-R11", properties:{label_zh:"推荐意见", name:"Some adults (≥26 years) may benefit from HPV vaccination. When deciding whether to vaccinate adults, consider: the likelihood of previous exposure to HPV; the future risks of HPV exposure and HPV disease.", label_en:"Recommendation"}}, {nodeId:"G07-R12", properties:{label_zh:"推荐意见", name:"Note that all men who have sex with men (MSM), including those aged ≥26 years, are recommended to receive HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G07-R13", properties:{label_zh:"推荐意见", name:"Many adults are likely to have been exposed to 1 or more HPV types contained in the vaccine through sexual activity. Vaccination will not clear a past or current infection, but can provide protection against future infections from other types contained in the vaccine. Adults aged ≥26 years who have been diagnosed with or have a history of HPV-related pre-cancerous/cancerous lesions may be considered for vaccination because of their inability to clear and control HPV infection, noting vaccination protects against future infections and does not have therapeutic benefits.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G07-R14", properties:{label_zh:"推荐意见", name:"The recommended schedule for adults aged ≥26 years is 3 doses, with an interval of 8 weeks between dose 1 and dose 2, and 16 weeks between dose 2 and dose 3.", label_en:"Recommendation"}}, {nodeId:"G07-R15", properties:{label_zh:"推荐意见", name:"A 3-dose schedule of 9vHPV vaccine is recommended for people with immunocompromising conditions, regardless of their age when they started vaccination.", label_en:"Recommendation"}}, {nodeId:"G07-R16", properties:{label_zh:"推荐意见", name:"Immunocompromising conditions include: Inborn errors of immunity, including primary immunodeficiency disorders; HIV infection; malignancy; haematopoietic stem cell transplant; solid organ transplant; immunosuppressive therapy.", label_en:"Recommendation"}}, {nodeId:"G07-R17", properties:{label_zh:"推荐意见", name:"People with asplenia or hyposplenia: People without a spleen are not considered at higher risk of persistent HPV infection and disease and are recommended to receive a 1-dose schedule if they are aged 9-25 years. This is the same as individuals with a functioning spleen.", label_en:"Recommendation"}}, {nodeId:"G07-R18", properties:{label_zh:"推荐意见", name:"MSM have a higher risk of repeated and persistent HPV infection and associated diseases, such as genital warts and anal cancer, at all ages and regardless of HIV status or other immunocompromising conditions. Men who have sex with men of any age are recommended to receive HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G07-R19", properties:{label_zh:"推荐意见", name:"Recommended doses and intervals by age group at the start of the course: Starting HPV vaccination at 9-25 years of age (except people who are immunocompromised) - 1 single dose; Starting HPV vaccination at ≥26 years of age - 3 doses (0, 2, 6 months); People who are immunocompromised at any age (excluding those with asplenia or hyposplenia) - 3 doses (0, 2, 6 months).", label_en:"Recommendation"}}, {nodeId:"G07-R20", properties:{label_zh:"推荐意见", name:"Gardasil 9: The dose of HPV vaccine is 0.5 mL given by intramuscular injection.", label_en:"Recommendation"}}, {nodeId:"G07-R21", properties:{label_zh:"推荐意见", name:"A single dose is recommended for immunocompetent people who start the HPV vaccination course at 9-25 years of age (that is, before their 26th birthday).", label_en:"Recommendation"}}, {nodeId:"G07-R22", properties:{label_zh:"推荐意见", name:"People who receive their 1st HPV vaccine dose at ≥26 years of age are recommended to receive 3 doses, with an interval of 8 weeks between dose 1 and dose 2, and 16 weeks between dose 2 and dose 3.", label_en:"Recommendation"}}, {nodeId:"G07-R23", properties:{label_zh:"推荐意见", name:"Although there is no specified upper limit for the interval before the final dose in the 3-dose schedule, it is advisable to complete the schedule as soon as possible. Doses do not need to be repeated if the recommended interval between doses is exceeded.", label_en:"Recommendation"}}, {nodeId:"G07-R24", properties:{label_zh:"推荐意见", name:"People who have completed the recommended number of doses of 2vHPV or 4vHPV vaccine are not routinely recommended to receive 9vHPV vaccine, because the extra benefit is considered to be marginal.", label_en:"Recommendation"}}, {nodeId:"G07-R25", properties:{label_zh:"推荐意见", name:"However, if the person wants protection against the additional HPV types, there appears to be no safety concerns associated with giving 9vHPV vaccine after a completed 2vHPV or 4vHPV vaccine course.", label_en:"Recommendation"}}, {nodeId:"G07-R26", properties:{label_zh:"推荐意见", name:"HPV vaccine can be given at the same time as the following vaccines, using separate syringes and injection sites: dTpa; dTpa-IPV; hepB; MenACWY; COVID-19 vaccines (if required).", label_en:"Recommendation"}}, {nodeId:"G07-R27", properties:{label_zh:"推荐意见", name:"If a multi-dose schedule is required, HPV vaccine can be used to complete an HPV vaccination schedule that was started with either the 4vHPV or the 2vHPV vaccine, as long as the appropriate minimum intervals and dose numbers are used.", label_en:"Recommendation"}}, {nodeId:"G07-R28", properties:{label_zh:"推荐意见", name:"The only absolute contraindications to HPV vaccine are: anaphylaxis after a previous dose of HPV vaccine; anaphylaxis after any component of HPV vaccine; anaphylaxis to yeast.", label_en:"Recommendation"}}, {nodeId:"G07-R29", properties:{label_zh:"推荐意见", name:"HPV vaccine is not recommended for pregnant women, due to an absence of evidence of vaccine use in large populations of pregnant women.", label_en:"Recommendation"}}, {nodeId:"G07-R30", properties:{label_zh:"推荐意见", name:"Women who become pregnant after starting the HPV vaccination course and require more than one dose are recommended to stop the vaccination course and receive the remaining doses after pregnancy.", label_en:"Recommendation"}}, {nodeId:"G07-R31", properties:{label_zh:"推荐意见", name:"Women who are inadvertently given a dose of HPV vaccine around the time of conception or during pregnancy should be reassured that there is evidence suggesting that vaccination does not harm the mother or the fetus in these situations.", label_en:"Recommendation"}}, {nodeId:"G07-R32", properties:{label_zh:"推荐意见", name:"Breastfeeding women can receive HPV vaccines.", label_en:"Recommendation"}}, {nodeId:"G07-R33", properties:{label_zh:"推荐意见", name:"Catch-up schedule for people ≥10 years of age: Human papillomavirus, if immunocompetent and started at 9-25 years of age - 1 dose; Human papillomavirus, people who are immunocompromised (any age) or if immunocompetent and started at ≥26 years of age - 3 doses, minimum intervals between doses 1 and 2: 4 weeks, between doses 2 and 3: 12 weeks, minimum interval between dose 1 and dose 3 is 20 weeks.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G08-R01", properties:{label_zh:"推荐意见", name:"For public health program-level decision-making: for provinces/territories making decisions for publicly funded immunization programs.", label_en:"Recommendation"}}, {nodeId:"G08-R02", properties:{label_zh:"推荐意见", original_grade:"Strong NACI recommendation", grade_system:"NACI推荐强度", name:"NACI continues to recommend HPV vaccination for all individuals 9 to 26 years of age.", label_en:"Recommendation"}}, {nodeId:"G08-R03", properties:{label_zh:"推荐意见", original_grade:"Strong NACI recommendation", grade_system:"NACI推荐强度", name:"NACI recommends that individuals 9 to 20 years of age should receive one dose of HPV vaccine, and individuals 21 to 26 years of age should receive two doses of HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G08-R04", properties:{label_zh:"推荐意见", original_grade:"Strong NACI recommendation", grade_system:"NACI推荐强度", name:"Nonavalent 9vHPV vaccine should be used, as it provides protection against the greatest number of HPV types and associated diseases.", label_en:"Recommendation"}}, {nodeId:"G08-R05", properties:{label_zh:"推荐意见", name:"For individual-level decision-making: healthcare providers advising individual clients.", label_en:"Recommendation"}}, {nodeId:"G08-R06", properties:{label_zh:"推荐意见", original_grade:"Discretionary NACI recommendation", grade_system:"NACI推荐强度", name:"Individuals 27 years of age and older may receive the HPV vaccine with shared decision-making and discussion with a healthcare provider. The vaccine should be given as a 2-dose schedule with doses administered at least 24 weeks apart.", label_en:"Recommendation"}}, {nodeId:"G08-R07", properties:{label_zh:"推荐意见", original_grade:"Discretionary NACI recommendation", grade_system:"NACI推荐强度", name:"A 2-dose schedule may be considered on an individual basis for individuals 9 to 20 years of age with their healthcare provider. When two doses are offered, doses should be administered at least 24 weeks apart.", label_en:"Recommendation"}}, {nodeId:"G08-R08", properties:{label_zh:"推荐意见", name:"HPV vaccines can be offered in pregnancy; routine questioning about last menstrual period or pregnancy is not required or recommended before offering the HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G08-R09", properties:{label_zh:"推荐意见", name:"NACI reiterates its current guidance on a 3-dose schedule for individuals who are considered immunocompromised, as well as individuals living with HIV, when recommended to receive HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G08-R10", properties:{label_zh:"推荐意见", name:"NACI emphasizes the ongoing need for additional public health measures, such as HPV infection and associated cancer screening and surveillance and early access to treatment to prevent HPV-associated diseases for all Canadians. Trends in HPV infection incidence or the incidence of HPV-associated outcomes will be important to monitor.", label_en:"Recommendation"}}, {nodeId:"G08-R11", properties:{label_zh:"推荐意见", name:"NACI also encourages dedicated efforts to implement such measures to equity-denied groups, including First Nations, Inuit and Métis people, some of whom face disproportionately high rates of HPV-associated cancers and lower rates of HPV immunization. Continuing to provide HPV vaccination in school-based programs has been shown to reduce health inequities.", label_en:"Recommendation"}}, {nodeId:"G09-R01", properties:{label_zh:"推荐意见", original_grade:"HPV2/HPV4 (Grade A); HPV9 (Grade B)", grade_system:"NACI证据等级", name:"Healthy (immunocompetent, non-HIV infected) Females 9-14 years of age (and healthy females ≥15 years of age in whom the first dose was administered between 9-14 years of age): 2- or 3-dose schedule; HPV2 or HPV4 (Grade A); HPV9 (Grade B).", label_en:"Recommendation"}}, {nodeId:"G09-R02", properties:{label_zh:"推荐意见", original_grade:"HPV2/HPV4 (Grade A); HPV9 (Grade B)", grade_system:"NACI证据等级", name:"Healthy (immunocompetent, non-HIV infected) Females ≥15 years of age: 3-dose schedule; HPV2 or HPV4 (Grade A) or HPV9 (Grade B).", label_en:"Recommendation"}}, {nodeId:"G09-R03", properties:{label_zh:"推荐意见", original_grade:"HPV4/HPV9 (Grade B)", grade_system:"NACI证据等级", name:"Healthy (immunocompetent, non-HIV infected) Males 9-14 years of age (and healthy males ≥15 years of age in whom the first dose was administered between 9-14 years of age): 2- or 3-dose schedule; HPV4 or HPV9 (Grade B).", label_en:"Recommendation"}}, {nodeId:"G09-R04", properties:{label_zh:"推荐意见", original_grade:"HPV4/HPV9 (Grade B)", grade_system:"NACI证据等级", name:"Healthy (immunocompetent, non-HIV infected) Males ≥15 years of age: 3-dose schedule; HPV4 or HPV9 (Grade B).", label_en:"Recommendation"}}, {nodeId:"G09-R05", properties:{label_zh:"推荐意见", original_grade:"HPV2/HPV4 (Grade B); HPV9 (Grade I)", grade_system:"NACI证据等级", name:"Immunocompromised individuals and immunocompetent HIV-infected individuals: 3-dose schedule; HPV2 or HPV4 in females (Grade B); HPV4 in males (Grade B); HPV9 in females or males (Grade I).", label_en:"Recommendation"}}, {nodeId:"G09-R06", properties:{label_zh:"推荐意见", name:"Efforts should be made to administer HPV vaccines at the recommended intervals. When an abbreviated schedule is required, vaccine doses should not be administered earlier than the minimum intervals between doses. In a 3-dose schedule, the minimum interval between the first and second doses of vaccine is 4 weeks, the minimum interval between the second and third doses of vaccine is 12 weeks and the minimum interval between the first and last doses in either a 2-dose or 3-dose schedule is 24 weeks.", label_en:"Recommendation"}}, {nodeId:"G09-R07", properties:{label_zh:"推荐意见", original_grade:"证据不足", grade_system:"NACI证据等级", name:"There is insufficient evidence at this time to recommend, at a population level, re-immunization with HPV9 vaccine in individuals who have completed an immunization series with another HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G10-R01", properties:{label_zh:"推荐意见", name:"Introduction of a free in-school vaccination program for boys as it is for girls in grade 4 (in Québec).", label_en:"Recommendation"}}, {nodeId:"G10-R02", properties:{label_zh:"推荐意见", name:"Free vaccination for all MSM up to 26 years of age, as it is currently offered to immunosuppressed women and men.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G10-R03", properties:{label_zh:"推荐意见", name:"Dissemination of information about the vaccine and the fact that it is free for the MSM population through schools during the vaccination period, in places where gay men socialize, and to healthcare professionals.", label_en:"Recommendation"}}, {nodeId:"G10-R04", properties:{label_zh:"推荐意见", name:"Evaluation of the implementation and impact of the selected vaccination strategy or strategies against HPV (e.g., vaccination coverage, assessment of the satisfaction and usefulness of the information tools developed, possible reduction in disease burden, etc.).", label_en:"Recommendation"}}, {nodeId:"G11-R01", properties:{label_zh:"推荐意见", name:"Human papillomavirus (HPV) vaccines are made from recombinant L1 major proteins assembled into virus-like particles.", label_en:"Recommendation"}}, {nodeId:"G11-R02", properties:{label_zh:"推荐意见", name:"The purpose of these vaccines is to reduce the risk of genital warts and HPV-related cancers including cervical and vulvar cancer, head and neck cancer, anal cancer, and penile cancer.", label_en:"Recommendation"}}, {nodeId:"G11-R03", properties:{label_zh:"推荐意见", name:"In Korea, bivalent (16, 18) vaccines, quadrivalent vaccines (6, 11, 16, 18), and 9-valent vaccines (6, 11, 16, 18, 31, 33, 45, 52, 58) are used depending on the type of HPV.", label_en:"Recommendation"}}, {nodeId:"G11-R04", properties:{label_zh:"推荐意见", name:"Bivalent and quadrivalent vaccines are national immunizations targeting girls aged 11-12 years and low-income young females aged 18-26 years.", label_en:"Recommendation"}}, {nodeId:"G11-R05", properties:{label_zh:"推荐意见", name:"Age and range of inoculation: these vaccines are routinely administered at 11 or 12 years of age, 2 doses administered 6 months apart for 12-14 years of age in both sexes.", label_en:"Recommendation"}}, {nodeId:"G11-R06", properties:{label_zh:"推荐意见", name:"For males and females aged 15-26 years, 3 doses are administered depending on the type of vaccine.", label_en:"Recommendation"}}, {nodeId:"G11-R07", properties:{label_zh:"推荐意见", name:"For older ages, vaccination can be given to those aged up to 45 years through consultation with a clinician.", label_en:"Recommendation"}}, {nodeId:"G11-R08", properties:{label_zh:"推荐意见", name:"In the case of 2 doses, they should be given at least 5 months apart; in the case of 3 doses, it is recommended to keep 4 weeks between the 1st and 2nd doses, 12 weeks between the 2nd and 3rd doses, and 5 months between the 1st and 3rd doses.", label_en:"Recommendation"}}, {nodeId:"G11-R09", properties:{label_zh:"推荐意见", name:"Immunocompromised patients such as those with HIV, malignant neoplasms, autoimmune diseases, and those undergoing transplantation or immunosuppressive therapy should receive 3 doses.", label_en:"Recommendation"}}, {nodeId:"G11-R10", properties:{label_zh:"推荐意见", name:"HPV vaccine is not recommended during pregnancy.", label_en:"Recommendation"}}, {nodeId:"G12-R01", properties:{label_zh:"推荐意见", original_grade:"IA", grade_system:"KSGO证据与推荐分级", name:"The optimal age for the 3-dose schedule of the quadrivalent HPV vaccine is 9-45 years in girls and women and 9-26 years in boys and men.", label_en:"Recommendation"}}, {nodeId:"G12-R02", properties:{label_zh:"推荐意见", original_grade:"IA", grade_system:"KSGO证据与推荐分级", name:"The optimal age for the three-dose schedule of the bivalent HPV vaccine is 9-45 years in girls and women.", label_en:"Recommendation"}}, {nodeId:"G12-R03", properties:{label_zh:"推荐意见", original_grade:"IIC", grade_system:"KSGO证据与推荐分级", name:"The optimal age for the three-dose schedule of the bivalent HPV vaccine is 9-25 years in boys and men.", label_en:"Recommendation"}}, {nodeId:"G12-R04", properties:{label_zh:"推荐意见", original_grade:"IA", grade_system:"KSGO证据与推荐分级", name:"The optimal age for the three-dose schedule of the nonavalent HPV vaccine is 9-26 years in girls and women.", label_en:"Recommendation"}}, {nodeId:"G12-R05", properties:{label_zh:"推荐意见", original_grade:"IIIB", grade_system:"KSGO证据与推荐分级", name:"The optimal age for the three-dose schedule of the nonavalent HPV vaccine is 27-45 years in women.", label_en:"Recommendation"}}, {nodeId:"G12-R06", properties:{label_zh:"推荐意见", original_grade:"IA", grade_system:"KSGO证据与推荐分级", name:"The optimal age for the three-dose schedule of the nonavalent HPV vaccine is 9-26 years in boys and men.", label_en:"Recommendation"}}, {nodeId:"G12-R07", properties:{label_zh:"推荐意见", original_grade:"IIB", grade_system:"KSGO证据与推荐分级", name:"In HPV-infected women already, the administration of the quadrivalent HPV vaccine can lower the risk of infection with an uninfected HPV subtype.", label_en:"Recommendation"}}, {nodeId:"G12-R08", properties:{label_zh:"推荐意见", original_grade:"IIB", grade_system:"KSGO证据与推荐分级", name:"In HPV-infected women already, the administration of the bivalent HPV vaccine can lower the risk of infection with an uninfected HPV subtype.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G12-R09", properties:{label_zh:"推荐意见", original_grade:"IIB", grade_system:"KSGO证据与推荐分级", name:"In HPV-infected women already, the administration of the nonavalent HPV vaccine can lower the risk of infection with an uninfected HPV subtype.", label_en:"Recommendation"}}, {nodeId:"G12-R10", properties:{label_zh:"推荐意见", original_grade:"IIB", grade_system:"KSGO证据与推荐分级", name:"In women who underwent conization, the administration of the quadrivalent HPV vaccine can reduce the risk of recurrence of HPV-related diseases by preventing infection with the corresponding viral subtype.", label_en:"Recommendation"}}, {nodeId:"G12-R11", properties:{label_zh:"推荐意见", original_grade:"IIB", grade_system:"KSGO证据与推荐分级", name:"In women who underwent conization, the administration of the bivalent HPV vaccine can reduce the risk of recurrence of HPV-related diseases by preventing infection with the corresponding viral subtype.", label_en:"Recommendation"}}, {nodeId:"G12-R12", properties:{label_zh:"推荐意见", original_grade:"IVB", grade_system:"KSGO证据与推荐分级", name:"In women who underwent conization, the administration of the nonavalent HPV vaccine can reduce the risk of recurrence of HPV-related diseases by preventing infection with the corresponding viral subtype.", label_en:"Recommendation"}}, {nodeId:"G13-R01", properties:{label_zh:"推荐意见", name:"A 1 dose schedule for the routine adolescent programme and GBMSM programme for eligible individuals less than 25 years of age.", label_en:"Recommendation"}}, {nodeId:"G13-R02", properties:{label_zh:"推荐意见", name:"A 2 dose schedule for the GBMSM programme for eligible individuals from the age of 25 years (0, 6 to 24 months).", label_en:"Recommendation"}}, {nodeId:"G13-R03", properties:{label_zh:"推荐意见", name:"A 3 dose schedule for eligible individuals who are immunosuppressed and those known to be living with HIV, including those on antiretroviral therapy (0, 1, 4 to 6 month schedule).", label_en:"Recommendation"}}, {nodeId:"G14-R01", properties:{label_zh:"推荐意见", name:"Prophylactic HPV vaccinations should be an integral part of the comprehensive cervical cancer prevention in Poland. Human papillomavirus vaccines enable the reduction of the incidence of other diseases etiologically related to HPV infections.", label_en:"Recommendation"}}, {nodeId:"G14-R02", properties:{label_zh:"推荐意见", name:"The priority target group for HPV vaccination are girls aged 11-13 years.", label_en:"Recommendation"}}, {nodeId:"G14-R03", properties:{label_zh:"推荐意见", name:"As the next step, girls over 13 years of age and boys 11-13 years of age should be vaccinated.", label_en:"Recommendation"}}, {nodeId:"G14-R04", properties:{label_zh:"推荐意见", name:"We should strive for the fastest possible implementation of free-of-charge HPV vaccinations of adolescents aged 11-13 years within the Preventive Immunization Programme.", label_en:"Recommendation"}}, {nodeId:"G14-R05", properties:{label_zh:"推荐意见", name:"Population-based vaccinations against HPV should be ultimately implemented within the framework of the existing, proven, organizational solutions in Preventive Immunization Programme in order to cover the target cohorts as widely as possible.", label_en:"Recommendation"}}, {nodeId:"G14-R06", properties:{label_zh:"推荐意见", name:"The qualification for HPV vaccination does not differ from other vaccinations. The only permanent, absolute contraindication is an anaphylactic reaction after a previous dose or to a vaccine component. Mild or moderate reactions after a previous dose are not contraindications. There is no need for a pregnancy test before administration. Hormonal contraceptives have no effect on the immune response. Temporary/relative contraindications include moderate or severe acute illness and exacerbation of chronic disease; vaccination is postponed until symptoms subside or remission is achieved.", label_en:"Recommendation"}}, {nodeId:"G14-R07", properties:{label_zh:"推荐意见", name:"HPV vaccines can be administered concurrently or at any intervals with other vaccines, but in a different site. The safety of concurrent administration with pertussis, diphtheria, tetanus, inactivated polio, hepatitis A and B, meningococcal and COVID-19 vaccines has been tested and demonstrated. During group vaccination campaigns, fainting may occur; giving patients a drink, a snack, ensuring safety and vaccinating while lying or sitting prevents syncope; patients should be observed for 30 minutes after vaccination.", label_en:"Recommendation"}}, {nodeId:"G14-R08", properties:{label_zh:"推荐意见", name:"In order to achieve optimal population effects, if it is necessary to select one product for vaccination under the Preventive Immunisation Programme, the selection of the vaccine should be made based on an independent pharmaco-economic analysis taking into account data from clinical trials in terms of efficacy against key endpoints, vaccine price achieved in a tender and distribution of HPV genotypes in lesions in Poland.", label_en:"Recommendation"}}, {nodeId:"G14-R09", properties:{label_zh:"推荐意见", name:"People older than planned for the free-of-charge immunization in the Preventive Immunisation Programme may also benefit from HPV immunization and should be vaccinated in line with the prescribing information for all three approved vaccines.", label_en:"Recommendation"}}, {nodeId:"G14-R10", properties:{label_zh:"推荐意见", name:"Human papillomavirus vaccination should be recommended to women diagnosed and treated for precancerous conditions of the cervix, as they may benefit from a lower risk of recurrence of lesions.", label_en:"Recommendation"}}, {nodeId:"G14-R11", properties:{label_zh:"推荐意见", name:"An extremely important element of the implementation of HPV vaccines are educational activities in target populations for vaccinations and their guardians, for medical personnel and the entire society, conducted centrally (media campaigns), regionally/locally (conferences, information activities) and individually (clinics and offices) in order to provide maximum information about the benefits of HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G15-R01", properties:{label_zh:"推荐意见", name:"All children at 12-13 years of age should receive HPV vaccine as part of the national HPV vaccination programme.", label_en:"Recommendation"}}, {nodeId:"G15-R02", properties:{label_zh:"推荐意见", name:"HPV catch-up vaccination is recommended for unvaccinated females and males under the age of 25 years. Second level students and females under the age of 25 years should be prioritised.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G15-R03", properties:{label_zh:"推荐意见", name:"Ideally, the vaccine should be administered before potential exposure to HPV through sexual contact.", label_en:"Recommendation"}}, {nodeId:"G15-R04", properties:{label_zh:"推荐意见", name:"Those who are sexually active should be advised that the vaccine has not been shown to have a therapeutic effect on existing HPV infection or cervical lesions.", label_en:"Recommendation"}}, {nodeId:"G15-R05", properties:{label_zh:"推荐意见", name:"HPV9 vaccine is recommended for MSM aged ≤45 years.", label_en:"Recommendation"}}, {nodeId:"G15-R06", properties:{label_zh:"推荐意见", name:"All immunocompromised persons should be given 3 doses of HPV9 vaccine at 0, 2 and 6 months, regardless of age.", label_en:"Recommendation"}}, {nodeId:"G15-R07", properties:{label_zh:"推荐意见", name:"HPV9 vaccine is recommended for haematopoietic stem cell or solid organ transplant recipients aged ≤45 years.", label_en:"Recommendation"}}, {nodeId:"G15-R08", properties:{label_zh:"推荐意见", name:"HPV9 vaccine is recommended for HIV infected men and women aged ≤26 years.", label_en:"Recommendation"}}, {nodeId:"G15-R09", properties:{label_zh:"推荐意见", name:"HPV9 vaccine is recommended for HIV infected MSM aged ≤45 years.", label_en:"Recommendation"}}, {nodeId:"G15-R10", properties:{label_zh:"推荐意见", name:"HPV9 vaccine is recommended for those with malignant haematological disorders, non-haematological malignant solid tumours, primary immunodeficiency, or within two weeks of commencing / three to six months of receiving significant immunosuppressive therapy.", label_en:"Recommendation"}}, {nodeId:"G15-R11", properties:{label_zh:"推荐意见", name:"Patients with Fanconi Anaemia aged over 12 months should be offered HPV vaccine as soon as the diagnosis is made.", label_en:"Recommendation"}}, {nodeId:"G15-R12", properties:{label_zh:"推荐意见", name:"HPV9 vaccine should be offered to previously unvaccinated women aged ≤45 years with CIN2+ lesions requiring excisional treatment.", label_en:"Recommendation"}}, {nodeId:"G15-R13", properties:{label_zh:"推荐意见", name:"HPV9 vaccine may be offered to previously unvaccinated women aged ≤45 years with CIN1 lesions.", label_en:"Recommendation"}}, {nodeId:"G15-R14", properties:{label_zh:"推荐意见", name:"HPV vaccine may be considered in children less than 12 years of age at risk of HPV exposure (e.g., with a history of sexual abuse or a sexually transmitted infection).", label_en:"Recommendation"}}, {nodeId:"G15-R15", properties:{label_zh:"推荐意见", name:"Contraindications: anaphylaxis to any of the vaccine constituents.", label_en:"Recommendation"}}, {nodeId:"G15-R16", properties:{label_zh:"推荐意见", name:"Precautions: acute severe febrile illness; defer until recovery.", label_en:"Recommendation"}}, {nodeId:"G15-R17", properties:{label_zh:"推荐意见", name:"HPV vaccine is not recommended during pregnancy.", label_en:"Recommendation"}}, {nodeId:"G15-R18", properties:{label_zh:"推荐意见", name:"If a woman becomes pregnant during the vaccination series, remaining doses should be delayed until after completion of the pregnancy.", label_en:"Recommendation"}}, {nodeId:"G15-R19", properties:{label_zh:"推荐意见", name:"The vaccines can be given with any other recommended vaccines, for instance MenACWY and Tdap. These should be given in the opposite limb to HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G15-R20", properties:{label_zh:"推荐意见", name:"Adverse reactions, local: pain, swelling and erythema are very common.", label_en:"Recommendation"}}, {nodeId:"G15-R21", properties:{label_zh:"推荐意见", name:"Adverse reactions, general: fever (≥38°C), headache, dizziness, nausea, fatigue are very common or common, generally resolving within 1-2 days. Syncope is uncommon.", label_en:"Recommendation"}}, {nodeId:"G16-R01", properties:{label_zh:"推荐意见", name:"WHO recommends the use of validated HPV DNA NAATs on self-collected vaginal or provider-collected cervical samples in a screen-and-treat approach, or in a screen, triage and treat approach, starting at the age of 30 years and repeated at 5-10-year intervals (25 years and 3-5-year intervals for immunocompromised women).", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G16-R02", properties:{label_zh:"推荐意见", name:"The 2020 WHO Global Strategy to Accelerate the Elimination of Cervical Cancer as a Public Health Problem recommends that HPV vaccines should be included in all national immunization programmes and should reach 90% of all girls by age 15 by 2030. The priority purpose of HPV immunization is the prevention of cervical cancer.", label_en:"Recommendation"}}, {nodeId:"G16-R03", properties:{label_zh:"推荐意见", name:"HPV vaccines should be introduced as part of a coordinated and comprehensive strategy to prevent cervical cancer and other diseases caused by HPV. This strategy should include education about reducing behaviours that increase the risk of acquiring HPV infection, and information about screening, diagnosis and treatment of precancerous lesions, cancer and risk factors.", label_en:"Recommendation"}}, {nodeId:"G16-R04", properties:{label_zh:"推荐意见", name:"HPV vaccination is a primary prevention intervention and does not eliminate the need for screening later in life.", label_en:"Recommendation"}}, {nodeId:"G16-R05", properties:{label_zh:"推荐意见", name:"The introduction of HPV vaccination should not be deferred because other relevant interventions cannot be implemented at the same time. It is not necessary to screen for HPV or HIV infection prior to HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G16-R06", properties:{label_zh:"推荐意见", name:"Countries should use approaches that are compatible with their delivery infrastructure and cold chain capacity, affordable and sustainable, and capable of achieving the highest possible coverage. Phased introductions should be only a short-term alternative.", label_en:"Recommendation"}}, {nodeId:"G16-R07", properties:{label_zh:"推荐意见", name:"The primary objective of HPV programmes is to achieve the highest possible population protection among girls by the time they reach 15 years of age; multiple opportunities should therefore be provided for girls to receive their HPV vaccine doses.", label_en:"Recommendation"}}, {nodeId:"G16-R08", properties:{label_zh:"推荐意见", name:"Catch-up vaccination of multiple age cohorts (MACs) of girls aged between 9 and 18 years at the time of introducing the HPV vaccine results in faster and greater population impact, as a result of increased direct and herd protection.", label_en:"Recommendation"}}, {nodeId:"G16-R09", properties:{label_zh:"推荐意见", name:"For the prevention of cervical cancer, the WHO-recommended primary target population for HPV vaccination is girls aged 9-14 years before they become sexually active.", label_en:"Recommendation"}}, {nodeId:"G16-R10", properties:{label_zh:"推荐意见", name:"Vaccination of secondary target populations, e.g. females aged ≥15 years, boys, older males or MSM, is recommended only if this is feasible and affordable, and does not divert resources from vaccination of the primary target population or effective cervical cancer screening programmes.", label_en:"Recommendation"}}, {nodeId:"G16-R11", properties:{label_zh:"推荐意见", name:"The current evidence supports the recommendation that a 2-dose schedule be used in the primary target group from 9 years of age and for all older age groups for which HPV vaccines are licensed. The minimum interval between first and second dose is 6 months. A 12-month schedule results in higher GMTs and is suggested for programmatic and efficiency reasons. There is no maximum recommended interval between doses and longer intervals - up to 3 or 5 years - can be considered if useful from a programme perspective.", label_en:"Recommendation"}}, {nodeId:"G16-R12", properties:{label_zh:"推荐意见", name:"As an off-label option, a single-dose schedule can be used in girls and boys aged 9-20 years.", label_en:"Recommendation"}}, {nodeId:"G16-R13", properties:{label_zh:"推荐意见", name:"Individuals known to be immunocompromised or HIV-infected (regardless of age or antiretroviral therapy status) should receive at least two HPV vaccine doses (minimum 6 months interval) and, where possible, three doses.", label_en:"Recommendation"}}, {nodeId:"G16-R14", properties:{label_zh:"推荐意见", name:"Current evidence suggests that, from a public health perspective, all currently licensed bivalent, quadrivalent and nonavalent vaccines offer comparable immunogenicity, efficacy and effectiveness for the prevention of cervical precancer and cancer. The choice of HPV vaccine should be based on an assessment of locally relevant data and considerations including the scale of the HPV-associated public health problem, the approved population, product characteristics, price and programme considerations.", label_en:"Recommendation"}}, {nodeId:"G16-R15", properties:{label_zh:"推荐意见", name:"For single-dose schedules, HPV vaccines with data on efficacy or immunobridging are advised. Immunobridging refers to evidence that peak and 24-month plateau antibody levels for a vaccine are comparable to those of vaccines with proven single-dose efficacy.", label_en:"Recommendation"}}, {nodeId:"G16-R16", properties:{label_zh:"推荐意见", name:"Immunocompromised women and men, including those living with HIV, and children and adolescents who have faced sexual abuse are at increased risk of HPV-related disease. It is recommended that these individuals are considered for vaccination against HPV as a priority as part of the public health programme.", label_en:"Recommendation"}}, {nodeId:"G16-R17", properties:{label_zh:"推荐意见", name:"Travelers and health workers are not at increased risk of contracting HPV infection and should follow the vaccine recommendations for the general population.", label_en:"Recommendation"}}, {nodeId:"G16-R18", properties:{label_zh:"推荐意见", name:"HPV vaccines can be co-administered with other non-live and live vaccines using separate syringes and different injection sites. Specific HPV vaccines may be administered concomitantly with other routine vaccines containing diphtheria, tetanus and acellular pertussis, with no clinically relevant interference with antibody response. Co-administration of a booster dose of tetanus-diphtheria (Td) vaccination should be considered to improve programme efficiency and avoid missed opportunities.", label_en:"Recommendation"}}, {nodeId:"G16-R19", properties:{label_zh:"推荐意见", name:"Interchangeable use of HPV vaccines: in settings where several vaccines are in use, efforts should be made to administer the same vaccine for all doses when using a multidose schedule. However, if the vaccine used for the prior dose(s) is unknown or unavailable, any HPV vaccine can be administered to complete the recommended schedule.", label_en:"Recommendation"}}, {nodeId:"G16-R20", properties:{label_zh:"推荐意见", name:"HPV vaccines are safe and well tolerated and can be used in persons who are immunocompromised or HIV-infected. Adverse events following HPV vaccination are generally mild and of short duration.", label_en:"Recommendation"}}, {nodeId:"G16-R21", properties:{label_zh:"推荐意见", name:"HPV vaccines should not be given to anyone who has experienced a severe allergic reaction after a previous HPV vaccine dose, or to a component of the vaccine.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G16-R22", properties:{label_zh:"推荐意见", name:"As a precautionary measure, vaccination with HPV vaccine is not recommended in pregnancy. If pregnancy occurs following the first dose of vaccination, the subsequent dose should be delayed until after the pregnancy. Termination of pregnancy is not indicated if vaccination was carried out inadvertently during pregnancy.", label_en:"Recommendation"}}, {nodeId:"G16-R23", properties:{label_zh:"推荐意见", name:"Breastfeeding is not a contraindication for HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G16-R24", properties:{label_zh:"推荐意见", name:"HPV vaccine coverage should be monitored and included in national immunization data reporting systems, registries and periodic surveys.", label_en:"Recommendation"}}, {nodeId:"G16-R25", properties:{label_zh:"推荐意见", name:"All countries should consider developing population-based cancer registries or specific cervical cancer registries and improve links between immunization and screening services and cancer registries to measure the impact of vaccination and cervical cancer prevention programmes.", label_en:"Recommendation"}}, {nodeId:"G16-R26", properties:{label_zh:"推荐意见", name:"Further evidence should be generated on the long-term immunogenicity, efficacy, effectiveness and duration of protection of single-dose HPV schedules in girls aged 9-14 years, boys, older women and men, and children less than 9 years of age. Evidence is needed on the immune response and efficacy of reduced dose schedules in immunocompromised individuals and HIV-infected persons. Implementation research should be carried out to identify strategies to improve and sustain HPV vaccine uptake, especially in high-risk populations.", label_en:"Recommendation"}}, {nodeId:"G16-R27", properties:{label_zh:"推荐意见", name:"All HPV vaccines contain VLPs against high-risk HPV types 16 and 18; the nonavalent vaccine also contains VLPs against types 31, 33, 45, 52 and 58; the quadrivalent and nonavalent vaccines contain VLPs against HPV types 6 and 11. All HPV vaccines are intended to be administered, if possible, before the onset of sexual activity, and are indicated for use in females aged 9 years or older, licensed up to 26 or 45 years of age.", label_en:"Recommendation"}}, {nodeId:"G16-R28", properties:{label_zh:"推荐意见", name:"Manufacturers' schedules mostly depend on the age of the recipient: Cervarix is licensed for girls and boys aged 9-14 years as a 2-dose schedule (5-13 months apart), and from ≥15 years as a 3-dose schedule (0, 1-2.5, 5-12 months); Cecolin is licensed for girls aged 9-14 years as a 2-dose schedule (6 months apart), and from age 15 as a 3-dose schedule (0, 1-2, 5-8 months); Walrinvax is licensed for girls aged 9-14 years as a 2-dose schedule (6 months apart, minimum interval 5 months), and from age 15 as a 3-dose schedule (0, 2-3, 6-7 months); Gardasil is licensed for girls and boys aged 9-13 years as a 2-dose schedule (6 months apart), and from age 14 as a 3-dose schedule (0, 1-2, 4-6 months); Cervavax is licensed for girls and boys aged 9-14 years as a 2-dose schedule (6 months apart), and from age 15 as a 3-dose schedule (0, 2, 6 months); Gardasil9 is licensed for girls and boys aged 9-14 years as a 2-dose schedule (5-13 months apart), and from age 15 as a 3-dose schedule (0, 1-2, 4-6 months).", label_en:"Recommendation"}}, {nodeId:"G16-R29", properties:{label_zh:"推荐意见", name:"Among males and females of all ages receiving HPV vaccine, injection site reactions included pain (35-88%), redness (5-40%) and swelling (4-35%); severe pain was reported by approximately 6% of vaccinees. Mild systemic adverse events possibly related to vaccination included headache, dizziness, myalgia, arthralgia and gastrointestinal symptoms. In prelicensure trials, no serious adverse events attributable to the vaccine were recorded for either the quadrivalent (Gardasil) or bivalent (Cervarix) vaccine. For the nonavalent vaccine, the rate of serious adverse events attributable to the vaccine was <0.1%.", label_en:"Recommendation"}}, {nodeId:"G17-R01", properties:{label_zh:"推荐意见", original_grade:"↑↑ (Strong); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We recommend to vaccinate all children aged 9 to 14 years against HPV, irrespective of their gender and as early as possible.", label_en:"Recommendation"}}, {nodeId:"G17-R02", properties:{label_zh:"推荐意见", original_grade:"↑↑ (Strong); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We recommend to vaccinate HPV vaccine-naive adolescents aged 15 to 17 years against HPV, irrespective of their gender and as early as possible.", label_en:"Recommendation"}}, {nodeId:"G17-R03", properties:{label_zh:"推荐意见", original_grade:"↑ (Weak); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We suggest to vaccinate HPV vaccine-naive adolescents aged 18 to 26 years against HPV, irrespective of their gender.", label_en:"Recommendation"}}, {nodeId:"G17-R04", properties:{label_zh:"推荐意见", original_grade:"↓ (Weak against); 女性72.7%/男性81.8%", grade_system:"AWMF-S3分级", name:"We suggest against recommending the HPV vaccination to HPV vaccine-naive adults aged 27 years or older, irrespective of their gender.", label_en:"Recommendation"}}, {nodeId:"G17-R05", properties:{label_zh:"推荐意见", original_grade:"↓↓ (Strong against); 多数同意(62.5%)", grade_system:"AWMF-S3分级", name:"We recommend against HPV testing for decision-making before vaccination.", label_en:"Recommendation"}}, {nodeId:"G17-R06", properties:{label_zh:"推荐意见", original_grade:"↓↓ (Strong against); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We recommend against performing booster vaccinations after a complete vaccination series.", label_en:"Recommendation"}}, {nodeId:"G17-R07", properties:{label_zh:"推荐意见", original_grade:"0 (No recommendation); 强共识(100%)", grade_system:"AWMF-S3分级", name:"Continuation of a vaccination series started with the 4-valent HPV vaccine with the 9-valent HPV vaccine may be considered.", label_en:"Recommendation"}}, {nodeId:"G17-R08", properties:{label_zh:"推荐意见", original_grade:"0 (No recommendation); 多数同意(75%)", grade_system:"AWMF-S3分级", name:"For individuals that have already received a complete vaccination series with the 2-valent or 4-valent HPV vaccine, vaccination with the 9-valent HPV vaccine may be considered to achieve protection against additional types of HPV.", label_en:"Recommendation"}}, {nodeId:"G17-R09", properties:{label_zh:"推荐意见", original_grade:"↓ (Weak against); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We suggest against HPV vaccination with the aim of a therapeutic effect during treatment of existing HPV-associated lesions.", label_en:"Recommendation"}}, {nodeId:"G17-R10", properties:{label_zh:"推荐意见", original_grade:"0 (No recommendation); 共识(81.8%)", grade_system:"AWMF-S3分级", name:"For HPV vaccine-naive women with cervical intraepithelial neoplasia (CIN), HPV vaccination before or after treatment of CIN with the aim of reducing the recurrence rate may be considered.", label_en:"Recommendation"}}, {nodeId:"G17-R11", properties:{label_zh:"推荐意见", original_grade:"↑ (Weak); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We suggest to offer cervical cancer screening in accordance with the recommendations of the S3 guideline on prevention of cervical cancer and the requirements of the directives for organized cancer screening programs, irrespective of the HPV vaccination status.", label_en:"Recommendation"}}, {nodeId:"G17-R12", properties:{label_zh:"推荐意见", original_grade:"↑↑ (Strong); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We recommend to vaccinate immunosuppressed or immunocompromised children and adolescents aged 9 to 17 years against HPV, if this has not yet been done.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G17-R13", properties:{label_zh:"推荐意见", original_grade:"↑ (Weak); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We suggest to vaccinate immunosuppressed or immunocompromised individuals aged 18 years or older against HPV, if this has not yet been done, especially until the age of 26 years.", label_en:"Recommendation"}}, {nodeId:"G17-R14", properties:{label_zh:"推荐意见", original_grade:"↑ (Weak); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We suggest to use the vaccination regimens with three doses to vaccinate immunosuppressed or immunocompromised individuals of all age groups against HPV.", label_en:"Recommendation"}}, {nodeId:"G17-R15", properties:{label_zh:"推荐意见", original_grade:"↑↑ (Strong); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We recommend to vaccinate HIV-positive children and adolescents aged 9 to 17 years against HPV, if this has not yet been done.", label_en:"Recommendation"}}, {nodeId:"G17-R16", properties:{label_zh:"推荐意见", original_grade:"0 (No recommendation); 强共识(100%)", grade_system:"AWMF-S3分级", name:"In HIV-positive, HPV vaccine-naive adults aged 18 to 26 years, HPV vaccination may be considered after individual assessment of the vaccination indication taking the sexual history into consideration.", label_en:"Recommendation"}}, {nodeId:"G17-R17", properties:{label_zh:"推荐意见", original_grade:"↓↓ (Strong against); 共识(91.7%)", grade_system:"AWMF-S3分级", name:"We recommend against vaccinating HIV-positive adults aged 27 years or older who report having had multiple sex partners against HPV.", label_en:"Recommendation"}}, {nodeId:"G17-R18", properties:{label_zh:"推荐意见", original_grade:"↑ (Weak); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We suggest to use the vaccination regimens with three doses to vaccinate PLWH of all age groups against HPV.", label_en:"Recommendation"}}, {nodeId:"G17-R19", properties:{label_zh:"推荐意见", original_grade:"↑↑ (Strong); 强共识(100%)", grade_system:"AWMF-S3分级", name:"We recommend to vaccinate HPV vaccine-naive adolescents starting the use of HIV pre-exposure prophylaxis (PrEP) against HPV.", label_en:"Recommendation"}}, {nodeId:"G17-R20", properties:{label_zh:"推荐意见", original_grade:"↓ (Weak against); 共识(90.9%)", grade_system:"AWMF-S3分级", name:"We suggest against vaccinating HPV vaccine-naive adults starting the use of HIV pre-exposure prophylaxis (PrEP) against HPV.", label_en:"Recommendation"}}, {nodeId:"G18-R01", properties:{label_zh:"推荐意见", name:"HPV vaccine is recommended for routine vaccination at 11 or 12 years old. Vaccination can be started at age 9.", label_en:"Recommendation"}}, {nodeId:"G18-R02", properties:{label_zh:"推荐意见", name:"ACIP also recommends vaccination for everyone through age 26 years if not adequately vaccinated when younger.", label_en:"Recommendation"}}, {nodeId:"G18-R03", properties:{label_zh:"推荐意见", name:"Vaccination is not recommended for everyone older than age 26 years.", label_en:"Recommendation"}}, {nodeId:"G18-R04", properties:{label_zh:"推荐意见", name:"For adults ages 27 through 45 years, clinicians can consider discussing HPV vaccination with people who are most likely to benefit. HPV vaccination does not need to be discussed with most adults over age 26 years.", label_en:"Recommendation"}}, {nodeId:"G18-R05", properties:{label_zh:"推荐意见", name:"Routine vaccination: Age 11-12 years; can be started at age 9 years.", label_en:"Recommendation"}}, {nodeId:"G18-R06", properties:{label_zh:"推荐意见", name:"Catch-up vaccination: Age 13-26 years, if not adequately vaccinated.", label_en:"Recommendation"}}, {nodeId:"G18-R07", properties:{label_zh:"推荐意见", name:"Shared clinical decision-making: Some adults ages 27-45 years, if not adequately vaccinated.", label_en:"Recommendation"}}, {nodeId:"G18-R08", properties:{label_zh:"推荐意见", name:"Two doses of HPV vaccine are recommended for most people starting the series before their 15th birthday. The second dose of HPV vaccine should be given 6 to 12 months after the first dose. Adolescents who receive two doses less than 5 months apart will require a third dose of HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G18-R09", properties:{label_zh:"推荐意见", name:"Three doses of HPV vaccine are recommended for teens and young adults who start the series at ages 15 through 26 years, and for immunocompromised persons. The recommended three-dose schedule is 0, 1-2 months, and 6 months. Three doses are recommended for immunocompromised persons (including those with HIV infection) aged 9 through 26 years.", label_en:"Recommendation"}}, {nodeId:"G18-R10", properties:{label_zh:"推荐意见", name:"A severe allergic reaction (e.g., anaphylaxis) to a vaccine component or following a prior dose of HPV vaccine is a contraindication to receipt of HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G18-R11", properties:{label_zh:"推荐意见", name:"A moderate or severe acute illness is a precaution to vaccination, and vaccination should be deferred until symptoms of the acute illness improve.", label_en:"Recommendation"}}, {nodeId:"G18-R12", properties:{label_zh:"推荐意见", name:"9-valent HPV vaccine is produced in Saccharomyces cerevisiae (baker's yeast) and is contraindicated for persons with a history of immediate hypersensitivity to yeast.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G18-R13", properties:{label_zh:"推荐意见", name:"A minor acute illness (e.g., diarrhea or mild upper respiratory tract infection, with or without fever) is not a reason to defer vaccination.", label_en:"Recommendation"}}, {nodeId:"G18-R14", properties:{label_zh:"推荐意见", name:"HPV vaccine is not recommended for use during pregnancy. Women known to be pregnant should delay initiation of the vaccination series until after the pregnancy.", label_en:"Recommendation"}}, {nodeId:"G18-R15", properties:{label_zh:"推荐意见", name:"If a woman is found to be pregnant after starting the HPV vaccine series, second and/or third doses should be delayed until they are no longer pregnant.", label_en:"Recommendation"}}, {nodeId:"G18-R16", properties:{label_zh:"推荐意见", name:"Adolescents should be seated or lying down during vaccination and remain in that position for 15 minutes after vaccination.", label_en:"Recommendation"}}, {nodeId:"G18-R17", properties:{label_zh:"推荐意见", name:"The most common adverse reactions reported during clinical trials of HPV vaccines were local reactions at the site of injection. In prelicensure clinical trials, local reactions such as pain, redness, or swelling were reported by 20% to 90% of recipients. A temperature of 100°F during the 15 days after vaccination was reported in 10% to 13% of HPV vaccine recipients. A similar proportion of placebo recipients reported an elevated temperature.", label_en:"Recommendation"}}, {nodeId:"G18-R18", properties:{label_zh:"推荐意见", name:"A variety of systemic adverse reactions have been reported by vaccine recipients, including nausea, dizziness, myalgia, and malaise.", label_en:"Recommendation"}}, {nodeId:"G19-R01", properties:{label_zh:"推荐意见", name:"Gardasil 9, the HPV vaccine used in the U.S., prevents infection with the following nine types: HPV types 6 and 11, which cause 90% of genital warts; HPV types 16 and 18, two high-risk types that cause about 70% of cervical cancers and an even higher percentage of some of the other HPV-caused cancers; HPV types 31, 33, 45, 52, and 58, high-risk HPVs that account for an additional 10% to 20% of cervical cancers.", label_en:"Recommendation"}}, {nodeId:"G19-R02", properties:{label_zh:"推荐意见", name:"HPV vaccination is routinely recommended at age 11 or 12 years; vaccination can be started at age 9. HPV vaccination is recommended for all persons through age 26 for those who were not adequately vaccinated earlier.", label_en:"Recommendation"}}, {nodeId:"G19-R03", properties:{label_zh:"推荐意见", name:"Although the HPV vaccine is approved by the U.S. Food and Drug Administration (FDA) to be given through age 45, HPV vaccination is not recommended for routine administration to adults ages 27 through 45. Instead, clinicians can consider discussing with patients in this age group who were not adequately vaccinated earlier whether HPV vaccination is right for them. HPV vaccination in this age range provides less benefit because more people have already been exposed to the virus.", label_en:"Recommendation"}}, {nodeId:"G19-R04", properties:{label_zh:"推荐意见", name:"HPV vaccination should be delayed until after pregnancy, but pregnancy testing is not required before vaccination.", label_en:"Recommendation"}}, {nodeId:"G19-R05", properties:{label_zh:"推荐意见", name:"In the U.S., the HPV vaccine was licensed for two doses in younger recipients and three doses in older recipients.", label_en:"Recommendation"}}, {nodeId:"G19-R06", properties:{label_zh:"推荐意见", name:"To date, vaccine protection against infections with the targeted HPV types has been found to last for more than a decade.", label_en:"Recommendation"}}, {nodeId:"G19-R07", properties:{label_zh:"推荐意见", name:"More than two decades of safety monitoring show that the vaccines have caused no serious side effects. The most common problems have been brief soreness and other local symptoms at the injection site.", label_en:"Recommendation"}}, {nodeId:"G19-R08", properties:{label_zh:"推荐意见", name:"Women who have an HPV infection and/or an abnormal Pap test result that may indicate an HPV infection should still receive the HPV vaccine if they are in the appropriate age group (9 through 26 years) because the vaccine may protect them against high-risk HPV types that they have not yet acquired. However, they should be told that the vaccination will not cure them of current HPV infections or treat the abnormal results of their Pap test.", label_en:"Recommendation"}}, {nodeId:"G19-R09", properties:{label_zh:"推荐意见", name:"It is likely that someone previously infected with HPV will still get some residual benefit from vaccination, even if he or she has already been infected with one or more of the HPV types included in the vaccine.", label_en:"Recommendation"}}, {nodeId:"G19-R10", properties:{label_zh:"推荐意见", name:"Because the HPV vaccine does not protect against all HPV types that can cause cancer, women who have been HPV vaccinated are advised to follow the same screening recommendations as unvaccinated women.", label_en:"Recommendation"}}, {nodeId:"G20-R01", properties:{label_zh:"推荐意见", name:"The Advisory Committee on Immunization Practices and ACOG recommend routine human papillomavirus (HPV) vaccination for girls and boys at the target age of 11-12 years (but it may be given from the age of 9 years) as part of the adolescent immunization platform.", label_en:"Recommendation"}}, {nodeId:"G20-R02", properties:{label_zh:"推荐意见", name:"Obstetrician-gynecologists and other health care professionals should strongly recommend HPV vaccination to eligible patients and stress the benefits and safety of the HPV vaccine.", label_en:"Recommendation"}}, {nodeId:"G20-R03", properties:{label_zh:"推荐意见", name:"Obstetrician-gynecologists should assess and vaccinate adolescent girls and young women with the HPV vaccine during the catch-up period (ages 13–26 years), regardless of sexual activity, prior exposure to HPV, or sexual orientation, if they were not vaccinated in the target age of 11–12 years.", label_en:"Recommendation"}}, {nodeId:"G20-R04", properties:{label_zh:"推荐意见", name:"Obstetrician-gynecologists and other health care professionals should educate parents in their decision making regarding vaccinations for their daughters and sons.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G20-R05", properties:{label_zh:"推荐意见", name:"For some women aged 27-45 years who are previously unvaccinated, obstetrician-gynecologists and other health care professionals may use shared clinical decision making regarding the HPV vaccination, considering the patient’s risk for acquisition of a new HPV infection and whether the HPV vaccine may provide benefit.", label_en:"Recommendation"}}, {nodeId:"G20-R06", properties:{label_zh:"推荐意见", name:"The American College of Obstetrician-Gynecologists does not recommend that an individual who received the quadrivalent HPV vaccine be revaccinated with 9-valent HPV vaccine, including those aged 27-45 years who previously completed some, but not all, of the vaccine series when they were younger.", label_en:"Recommendation"}}, {nodeId:"G20-R07", properties:{label_zh:"推荐意见", name:"Obstetrician-gynecologists are encouraged to stock and administer HPV vaccine in their offices when feasible.", label_en:"Recommendation"}}, {nodeId:"G20-R08", properties:{label_zh:"推荐意见", name:"Vaccination is recommended for women through age 26 years even if the patient is tested for HPV DNA and the results are positive.", label_en:"Recommendation"}}, {nodeId:"G20-R09", properties:{label_zh:"推荐意见", name:"Testing for HPV DNA is not recommended before vaccination.", label_en:"Recommendation"}}, {nodeId:"G20-R10", properties:{label_zh:"推荐意见", name:"Human papillomavirus vaccination is not recommended during pregnancy; however, routine pregnancy testing is not recommended before vaccination.", label_en:"Recommendation"}}, {nodeId:"G20-R11", properties:{label_zh:"推荐意见", name:"The HPV vaccine can and should be given to breastfeeding women age 26 years and younger who have not previously been vaccinated.", label_en:"Recommendation"}}, {nodeId:"G20-R12", properties:{label_zh:"推荐意见", name:"In children with a history of sexual abuse or assault, the HPV vaccine should be given as early as possible, starting at age 9 years.", label_en:"Recommendation"}}, {nodeId:"G21-R01", properties:{label_zh:"推荐意见", name:"Routine HPV vaccination between ages 9-12 y is expected to achieve higher on-time vaccination rates, resulting in increased numbers of cancers prevented. Health care providers are encouraged to start offering the HPV vaccine at age 9 or 10 y.", label_en:"Recommendation"}}, {nodeId:"G21-R02", properties:{label_zh:"推荐意见", name:"Providers should inform individuals aged 22-26 y who have not been previously vaccinated or who have not completed the series that vaccination at older ages is less effective in lowering cancer risk.", label_en:"Recommendation"}}, {nodeId:"G21-R03", properties:{label_zh:"推荐意见", name:"The ACS does not endorse the recommendation for shared clinical decision making for adults aged 27-45 y because of the low effectiveness and low cancer prevention potential of vaccination in this age group, the burden of decision making on patients and clinicians, and the lack of sufficient guidance on selection of individuals who might benefit.", label_en:"Recommendation"}}, {nodeId:"G22-R01", properties:{label_zh:"推荐意见", name:"HPV vaccination is routinely recommended at age 11 or 12 y; vaccination can be given starting at age 9 y.", label_en:"Recommendation"}}, {nodeId:"G22-R02", properties:{label_zh:"推荐意见", name:"Vaccination is recommended for all persons through age 26 y who are not adequately vaccinated.", label_en:"Recommendation"}}, {nodeId:"G22-R03", properties:{label_zh:"推荐意见", name:"Catch-up HPV vaccination is not recommended for all adults aged >26 y. Instead, shared clinical decision making regarding HPV vaccination is recommended for some adults aged 27-45 y who are not adequately vaccinated. HPV vaccines are not licensed for use in adults aged >45 y.", label_en:"Recommendation"}}, {nodeId:"G22-R04", properties:{label_zh:"推荐意见", name:"Dosing schedules, intervals, and definitions of persons considered adequately vaccinated have not changed. No prevaccination testing (eg, Pap or HPV testing) is recommended to establish the appropriateness of HPV vaccination.", label_en:"Recommendation"}}, {nodeId:"G22-R05", properties:{label_zh:"推荐意见", name:"Cervical cancer screening guidelines and recommendations should be followed.", label_en:"Recommendation"}}, {nodeId:"G22-R06", properties:{label_zh:"推荐意见", name:"These recommendations for children and adults aged 9-26 y and for adults aged >26 y apply to all persons, regardless of behavioral or medical risk factors for HPV infection or disease.", label_en:"Recommendation"}}, {nodeId:"G22-R07", properties:{label_zh:"推荐意见", name:"For persons who are pregnant, HPV vaccination should be delayed until after pregnancy; however, pregnancy testing is not needed before vaccination.", label_en:"Recommendation"}}, {nodeId:"G22-R08", properties:{label_zh:"推荐意见", name:"Persons who are breastfeeding or lactating can receive HPV vaccine. Recommendations regarding HPV vaccination during pregnancy or lactation have not changed.", label_en:"Recommendation"}}, {nodeId:"G22-R09", properties:{label_zh:"推荐意见", name:"Clinicians should use shared decision-making to offer human papillomavirus (HPV) vaccination to adults aged 27 to 45 years who have not started or completed the vaccine series based on individual risk factors and likelihood of benefit.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G22-R10", properties:{label_zh:"推荐意见", name:"All males and females through age 26 years who did not start or complete routine vaccination by age 11 to 12 years should receive catch-up vaccination.", label_en:"Recommendation"}}, {nodeId:"G22-R11", properties:{label_zh:"推荐意见", name:"HPV vaccination is administered in a 3-dose schedule, with a second dose 1 to 2 months after the first and a third dose 6 months after the first, when initiated after the 15th birthday. When initiated before the 15th birthday, the vaccine is administered in a 2-dose schedule.", label_en:"Recommendation"}}, {nodeId:"G22-R12", properties:{label_zh:"推荐意见", name:"Persons with HIV and other immunocompromising conditions should receive the 3-dose schedule regardless of age.", label_en:"Recommendation"}}, {nodeId:"G22-R13", properties:{label_zh:"推荐意见", name:"HPV vaccination can be offered to persons who are breastfeeding or lactating. Vaccination should not be given during pregnancy, but a pregnancy test is not required before vaccination.", label_en:"Recommendation"}}, {nodeId:"G23-R01", properties:{label_zh:"推荐意见", original_grade:"evidence based / high / strong", grade_system:"ASCO证据质量与推荐强度", name:"A1a: Public health authorities ministries of health and primary care providers should routinely vaccinate girls with the target age range being as early as possible starting at 9 through 14 years of age.", label_en:"Recommendation"}}, {nodeId:"G23-R02", properties:{label_zh:"推荐意见", original_grade:"evidence based / low / moderate", grade_system:"ASCO证据质量与推荐强度", name:"A1b: Public health authorities may set the upper end of the target population higher than 14 years of age depending on local policies and resources.", label_en:"Recommendation"}}, {nodeId:"G23-R03", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"A2a: For girls 9 to 14 years of age who are immune competent a two-dose regimen is recommended.", label_en:"Recommendation"}}, {nodeId:"G23-R04", properties:{label_zh:"推荐意见", original_grade:"evidence based / high / strong", grade_system:"ASCO证据质量与推荐强度", name:"A2b (6 months): The interval between two doses should be at least 6 months.", label_en:"Recommendation"}}, {nodeId:"G23-R05", properties:{label_zh:"推荐意见", original_grade:"evidence based / low / weak", grade_system:"ASCO证据质量与推荐强度", name:"A2b (12–15 months): The interval between two doses may be up to 12 to 15 months.", label_en:"Recommendation"}}, {nodeId:"G23-R06", properties:{label_zh:"推荐意见", original_grade:"informal consensus-based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"A2c: Girls age ≥15 years at the time of the first dose or initiation who receive vaccine should receive three doses.", label_en:"Recommendation"}}, {nodeId:"G23-R07", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"A3: For females who have received one dose and are age >14 years public health authorities may provide additional doses or complete the series up to 26 years of age.", label_en:"Recommendation"}}, {nodeId:"G23-R08", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"A4 (low coverage): For prevention of cervical cancer if there is low vaccine coverage of the priority female target population (<50%) in maximal or enhanced resource settings vaccination may be extended to boys.", label_en:"Recommendation"}}, {nodeId:"G23-R09", properties:{label_zh:"推荐意见", original_grade:"evidence based / insufficient / weak", grade_system:"ASCO证据质量与推荐强度", name:"A4 (high coverage): For prevention of cervical cancer in maximal or enhanced resource settings where vaccine coverage of girls is ≥50% there are insufficient data to recommend for or against vaccination of boys.", label_en:"Recommendation"}}, {nodeId:"G23-R10", properties:{label_zh:"推荐意见", original_grade:"evidence based / high / strong", grade_system:"ASCO证据质量与推荐强度", name:"B1a: Public health authorities ministries of health and primary care providers should vaccinate girls as early as possible starting at 9 through 14 years of age.", label_en:"Recommendation"}}, {nodeId:"G23-R11", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"B2a: For girls starting at 9 years of age who are immune competent a two-dose regimen is recommended.", label_en:"Recommendation"}}, {nodeId:"G23-R12", properties:{label_zh:"推荐意见", original_grade:"evidence based / high / strong", grade_system:"ASCO证据质量与推荐强度", name:"B2b (6 months): The interval between the doses should be at least 6 months.", label_en:"Recommendation"}}, {nodeId:"G23-R13", properties:{label_zh:"推荐意见", original_grade:"evidence based / low / moderate", grade_system:"ASCO证据质量与推荐强度", name:"B2b (12–15 months): The interval between the doses may be up to 12 to 15 months.", label_en:"Recommendation"}}, {nodeId:"G23-R14", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"B3: If there are sufficient resources remaining after vaccinating high-priority populations with an adequate target (minimum recommended coverage is ≥50% with two doses with a target of 80%) for females who have received one dose and are age >14 years public health authorities may provide additional doses or complete the series up to 26 years of age.", label_en:"Recommendation"}}, {nodeId:"G23-R15", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"B4: For prevention of cervical cancer in limited resource settings: if girls coverage ≥50% boys vaccination not recommended; if <50% may extend to boys.", label_en:"Recommendation"}}, {nodeId:"G23-R16", properties:{label_zh:"推荐意见", original_grade:"evidence based / high / strong", grade_system:"ASCO证据质量与推荐强度", name:"C1: Public health authorities ministries of health and primary care providers should vaccinate girls in the priority target age group starting as early as possible through 14 years of age.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G23-R17", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"C2a: For girls starting at 9 years of age who are immune competent a two-dose regimen is recommended.", label_en:"Recommendation"}}, {nodeId:"G23-R18", properties:{label_zh:"推荐意见", original_grade:"evidence based / high / strong", grade_system:"ASCO证据质量与推荐强度", name:"C2b (6 months): The interval between the doses should be at least 6 months.", label_en:"Recommendation"}}, {nodeId:"G23-R19", properties:{label_zh:"推荐意见", original_grade:"evidence based / low / moderate", grade_system:"ASCO证据质量与推荐强度", name:"C2b (12–15 months): The interval between the doses may be up to 12 to 15 months.", label_en:"Recommendation"}}, {nodeId:"G23-R20", properties:{label_zh:"推荐意见", original_grade:"evidence based / high / strong", grade_system:"ASCO证据质量与推荐强度", name:"C3: High coverage of priority populations should be emphasized. Where coverage of the primary targeted group of females is high (≥50%) and resources allow the age group may be expanded upward in catch-up efforts.", label_en:"Recommendation"}}, {nodeId:"G23-R21", properties:{label_zh:"推荐意见", original_grade:"evidence based / intermediate / moderate", grade_system:"ASCO证据质量与推荐强度", name:"C4: For prevention of cervical cancer in basic resource settings: if girls coverage ≥50% boys vaccination not recommended; if <50% may extend to boys.", label_en:"Recommendation"}}, {nodeId:"G23-R22", properties:{label_zh:"推荐意见", original_grade:"evidence based / insufficient / weak", grade_system:"ASCO证据质量与推荐强度", name:"D: Females who are HIV positive or immunosuppressed for other reasons should follow the same age recommendations but should receive three doses.", label_en:"Recommendation"}}, {nodeId:"G23-R23", properties:{label_zh:"推荐意见", original_grade:"evidence based / insufficient / weak", grade_system:"ASCO证据质量与推荐强度", name:"E: HPV vaccination is not recommended for pregnant women.", label_en:"Recommendation"}}, {nodeId:"G23-R24", properties:{label_zh:"推荐意见", original_grade:"- / insufficient / -", grade_system:"ASCO证据质量与推荐强度", name:"F: No recommendation for women receiving treatment of cervical cancer precursor lesions (cervical intraepithelial neoplasia grade > 2; eg, conization, loop electrosurgical excision process, or cryotherapy; all resource settings).", label_en:"Recommendation"}}, {nodeId:"G24-R01", properties:{label_zh:"推荐意见", name:"We recommend that European Union policy advisors and healthcare planners in all countries facilitate the implementation of national HPV-vaccination programmes that: target all girls and boys; vaccinate adolescent girls and boys before the age of 15; consider social media as the main source of information for the target population.", label_en:"Recommendation"}}, {nodeId:"G25-R01", properties:{label_zh:"推荐意见", name:"Current national vaccination programs aim girls, and in a growing number of countries (Austria, Croatia, Czech Republic, Denmark, Finland, Germany, Italy, Norway, Slovakia, Switzerland, and UK in Europe; the US, Canada, New Zealand and Australia outside Europe) also boys, before the onset of puberty.", label_en:"Recommendation"}}, {nodeId:"G25-R02", properties:{label_zh:"推荐意见", name:"The vaccine is licensed from the age of 9 years.", label_en:"Recommendation"}}, {nodeId:"G25-R03", properties:{label_zh:"推荐意见", name:"On a population level, HPV vaccination is most effective when vaccination is administered early in life and should be given as early as possible in agreement with national guidelines and programs. This gives the optimal immunologic response and decreases the likelihood of HPV positivity at the time of vaccination.", label_en:"Recommendation"}}, {nodeId:"G25-R04", properties:{label_zh:"推荐意见", name:"Vaccination in older age groups can also offer some protection against HPV-related disease. The vaccines have been demonstrated to prevent new infections and disease up to the age of 45 years.", label_en:"Recommendation"}}, {nodeId:"G25-R05", properties:{label_zh:"推荐意见", name:"The use of the vaccine in older women can also be beneficial at an individual level.", label_en:"Recommendation"}}, {nodeId:"G25-R06", properties:{label_zh:"推荐意见", name:"Austria, the US, Australia, recently Germany, the UK and other countries have implemented gender-neutral vaccination. The feasibility of a gender-neutral vaccination program depends on the local resources but should be the preferred concept.", label_en:"Recommendation"}}, {nodeId:"G25-R07", properties:{label_zh:"推荐意见", name:"The vaccines are also effective in sexually active women and men with previous but cleared infections.", label_en:"Recommendation"}}, {nodeId:"G25-R08", properties:{label_zh:"推荐意见", name:"Because these patients have an increased risk for other HPVrelated disease and cancer, for cervical intra-epithelial neoplasia, vaccination can be offered on an individual basis.", label_en:"Recommendation"}}, {nodeId:"G25-R09", properties:{label_zh:"推荐意见", name:"It appears that school-based programs or other wellorganised public health structures are most effective and ensure equity and hence far superior to opportunistic vaccination. As school-based vaccination may not be feasible in every country, the decision on the setting that could optimise coverage should be in line with the local infrastructure and resources.", label_en:"Recommendation"}}, {nodeId:"G25-R10", properties:{label_zh:"推荐意见", name:"The WHO recommends this practice for those younger than 15 years. It is important that the interval between the 2 doses must be 6-12 months.", label_en:"Recommendation"}}, {nodeId:"G25-R11", properties:{label_zh:"推荐意见", name:"There is no evidence to support the need for a booster, although protection may be lifelong.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G25-R12", properties:{label_zh:"推荐意见", name:"For those already vaccinated with a firstgeneration HPV vaccine, routine ‘revaccination’ with the ninevalent HPV vaccine is possible.", label_en:"Recommendation"}}, {nodeId:"G25-R13", properties:{label_zh:"推荐意见", name:"A full course of 3 doses (2 doses for those younger than 15 years) has to be applied. Although such a practice on an individual basis is possible, the balance of cost and effectiveness does not permit recommendation of vaccination in population-based programs.", label_en:"Recommendation"}}, {nodeId:"G25-R14", properties:{label_zh:"推荐意见", name:"HPV screening and vaccination are complementary preventive options often implemented as separate and non-coordinated programs. The HPV-FASTER protocol aims to address this disconnect by combining both strategies with the ultimate purpose of accelerating the reduction of cervical cancer incidence and mortality.", label_en:"Recommendation"}}, {nodeId:"G25-R15", properties:{label_zh:"推荐意见", name:"The proposal of the HPV-FASTER protocol is to offer HPV vaccination to women in a broad age range of 9-45 years, irrespective of HPV infection status.", label_en:"Recommendation"}}, {nodeId:"G25-R16", properties:{label_zh:"推荐意见", name:"Women older than 25/30 years would, in addition to the vaccination, be screened using a validated HPV test as part of their initial visit.", label_en:"Recommendation"}}, {nodeId:"G25-R17", properties:{label_zh:"推荐意见", name:"The European Society of Gynecological Oncology (ESGO) supports vaccination programs for children and young adolescents, with a catch-up program for young adults, if feasible, and also vaccination on an individual basis.", label_en:"Recommendation"}}, {nodeId:"G26-R01", properties:{label_zh:"推荐意见", name:"Young girls represent the target population for vaccination programs. After vaccine introduction, targeting multiple age cohorts between 9 and 18 years led to a higher and faster population impact (herd effect, indirect protection of unvaccinated women, direct protection of boys and men) compared to vaccination of single age cohorts.", label_en:"Recommendation"}}, {nodeId:"G26-R02", properties:{label_zh:"推荐意见", name:"Vaccination of secondary target populations, such as older adolescent females or young women or males, is not recommended as a priority.", label_en:"Recommendation"}}, {nodeId:"G26-R03", properties:{label_zh:"推荐意见", name:"In October 2018, the Food and Drug Administration extended the nonavalent HPV vaccine to men and women aged 27–45 years.", label_en:"Recommendation"}}, {nodeId:"G26-R04", properties:{label_zh:"推荐意见", name:"In 2017, the Italian government introduced free HPV vaccination for males and females at the age of 12.", label_en:"Recommendation"}}, {nodeId:"G26-R05", properties:{label_zh:"推荐意见", name:"The optimal timing for HPV vaccination would be before the sexual debut. Routine HPV vaccination is recommended at 11–12 years. However, it can be initially administered at the age of nine.", label_en:"Recommendation"}}, {nodeId:"G26-R06", properties:{label_zh:"推荐意见", name:"The WHO, the Cochrane library, the European Society of Gynecological Oncology, and the European Federation for Colposcopy recently recommended a two-dose schedule with an adequate distance between the two doses (0, 6–15 months) in young girls aged 9–14 years.", label_en:"Recommendation"}}, {nodeId:"G26-R07", properties:{label_zh:"推荐意见", name:"The WHO position paper reports that patients 15 years and older should receive a 3-dose schedule (0, 1–2, 6 months).", label_en:"Recommendation"}}, {nodeId:"G26-R08", properties:{label_zh:"推荐意见", name:"In Italy, the vaccine is recommended for all girls and boys during the 12th year of age.", label_en:"Recommendation"}}, {nodeId:"G26-R09", properties:{label_zh:"推荐意见", name:"The recommended dosing schedule depends on the patient’s age at vaccine initiation and the different HPV vaccine formulation.", label_en:"Recommendation"}}, {nodeId:"G26-R10", properties:{label_zh:"推荐意见", name:"In the absence of limitations related to availability and costs, the 9-valent vaccine is recommended.", label_en:"Recommendation"}}, {nodeId:"G26-R11", properties:{label_zh:"推荐意见", name:"The HPV vaccine can be administered in conjunction with other live and non-live vaccines. Different syringes and injection sites should be used.", label_en:"Recommendation"}}, {nodeId:"G26-R12", properties:{label_zh:"推荐意见", name:"The best method would be to always apply the same vaccine for all doses. However, if the vaccine used for the previous dose is unknown, any HPV vaccine can be administered to complete the vaccination course.", label_en:"Recommendation"}}, {nodeId:"G26-R13", properties:{label_zh:"推荐意见", name:"For those women already vaccinated with the bivalent or quadrivalent HPV vaccine, a further full course of three doses of the 9-valent HPV vaccine (2 doses for those younger than 15 years) is possible to achieve complete protection against the additional HPV types.", label_en:"Recommendation"}}, {nodeId:"G26-R14", properties:{label_zh:"推荐意见", name:"The cost-effectiveness evaluation does not allow for the recommendation of a \"revaccination\" in population-based programs.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"G26-R15", properties:{label_zh:"推荐意见", name:"In the new Italian National Vaccinal Prevention Plan 2017–2019, free vaccination during the twelfth year of age is expected for males, starting from the 2006 cohort.", label_en:"Recommendation"}}, {nodeId:"G26-R16", properties:{label_zh:"推荐意见", name:"The HPV vaccine is safe for HIV or immunocompromised patients.", label_en:"Recommendation"}}, {nodeId:"G26-R17", properties:{label_zh:"推荐意见", name:"The HPV vaccine is also recommended in an at-risk male subpopulation, such as MSM.", label_en:"Recommendation"}}, {nodeId:"G26-R18", properties:{label_zh:"推荐意见", name:"HPV vaccination should be avoided in pregnant women due to the absence of data in the literature.", label_en:"Recommendation"}}, {nodeId:"G26-R19", properties:{label_zh:"推荐意见", name:"If a woman becomes pregnant during vaccination, subsequent doses should be postponed until after childbirth, but no intervention is needed.", label_en:"Recommendation"}}, {nodeId:"G26-R20", properties:{label_zh:"推荐意见", name:"Travelers and healthcare professionals should follow recommendations like the general population.", label_en:"Recommendation"}}, {nodeId:"G26-R21", properties:{label_zh:"推荐意见", name:"Special high-risk clinical conditions may also be considered as a new potential target population: patients with inflammatory bowel disease (IBD), patients under biological treatment, transplanted subjects, and subfertile men/couples.", label_en:"Recommendation"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:推荐意见;
UNWIND [{nodeId:"STU001", properties:{label_zh:"研究", study_type:"免疫原性试验", name:"9vHPV疫苗对27-45岁女性的免疫原性研究", label_en:"Study", outcome:"免疫原性（非劣效）", population:"27-45岁女性", name_en:"immunogenicity study of 9vHPV vaccine in women aged 27-45 years"}}, {nodeId:"STU002", properties:{label_zh:"研究", study_type:"长期随访研究/队列研究", name:"4vHPV疫苗接种后长达十年的保护随访研究", label_en:"Study", outcome:"CIN或生殖器疣预防", population:"4vHPV接种者", name_en:"4vHPV follow-up study up to a decade post-vaccination"}}, {nodeId:"STU003", properties:{label_zh:"研究", study_type:"随机对照试验(RCT)", name:"2vHPV疫苗效力试验", label_en:"Study", outcome:"持续感染/任意CIN/外生殖器病变（效力90.5%）", name_en:"2vHPV vaccine efficacy trial (90.5% efficacy)", population:"女性"}}, {nodeId:"STU004", properties:{note:"证据缺口：尚无相关RCT", label_zh:"研究", study_type:"随机对照试验(RCT)", name:"27-45岁成年男性HPV疫苗接种RCT（尚无）", label_en:"Study", outcome:"—", name_en:"no RCT of HPV vaccination for adult males aged 27-45 years", population:"27-45岁成年男性"}}, {nodeId:"STU005", properties:{label_zh:"研究", study_type:"随机对照试验(RCT)", name:"HPV疫苗接种方案的随机对照试验", label_en:"Study", outcome:"剂次方案效果", name_en:"randomized controlled trials on HPV vaccination dosing schedules", population:"接种人群"}}, {nodeId:"STU006", properties:{label_zh:"研究", study_type:"事后分析/真实世界研究", name:"既往试验的事后分析与真实世界数据（1/2剂方案）", label_en:"Study", outcome:"较少剂次方案效果（结果不一致）", population:"既往试验受试者", name_en:"post-hoc analyses of previous trials and real-world data on 1/2-dose schedules"}}, {nodeId:"STU007", properties:{label_zh:"研究", study_type:"临床研究（进行中）", name:"9vHPV疫苗对口咽HPV感染的效力研究（进行中）", label_en:"Study", outcome:"口腔HPV感染预防", population:"口咽HPV感染人群", name_en:"ongoing research on efficacy of 9vHPV against oral HPV infections"}}, {nodeId:"STU008", properties:{label_zh:"研究", study_type:"上市前临床试验", name:"HPV疫苗上市前临床试验（4价/2价）", label_en:"Study", outcome:"严重不良事件（未记录到）", population:"Gardasil/Cervarix受试者", name_en:"prelicensure trials of quadrivalent (Gardasil) and bivalent (Cervarix) vaccines"}}, {nodeId:"STU009", properties:{label_zh:"研究", study_type:"上市前临床试验", name:"9价HPV疫苗上市前试验", label_en:"Study", outcome:"严重不良事件率<0.1%", name_en:"prelicensure trials of nonavalent HPV vaccine", population:"9vHPV受试者"}}, {nodeId:"STU011", properties:{label_zh:"研究", study_type:"人群试验", name:"单剂次HPV疫苗效力试验", label_en:"Study", outcome:"单剂次保护效力", population:"9-20岁女孩和男孩", name_en:"single-dose HPV vaccine efficacy trials"}}, {nodeId:"STU012", properties:{label_zh:"研究", study_type:"免疫桥接试验", name:"免疫桥接研究", label_en:"Study", outcome:"峰值及24个月平台期抗体水平", population:"各疫苗受试者", name_en:"immunobridging studies"}}, {nodeId:"STU013", properties:{label_zh:"研究", study_type:"上市后安全性监测", name:"二十余年上市后安全性监测", label_en:"Study", outcome:"严重副作用（未发现）", population:"HPV疫苗受种者", name_en:"more than two decades of safety monitoring"}}, {nodeId:"STU014", properties:{label_zh:"研究", study_type:"随访研究", name:"疫苗保护持续时间研究", label_en:"Study", outcome:"对目标型别感染保护>10年", population:"HPV疫苗受种者", name_en:"studies on duration of vaccine protection"}}, {nodeId:"STU015", properties:{label_zh:"研究", study_type:"临床研究", name:"疫苗对最高45岁人群的保护作用研究", label_en:"Study", outcome:"预防新发感染和疾病", population:"最高至45岁人群", name_en:"studies demonstrating prevention of new infections and disease up to age 45"}}, {nodeId:"STU016", properties:{label_zh:"研究", study_type:"人群研究", name:"多年龄队列接种的人群影响评估", label_en:"Study", outcome:"人群影响（群体效应/间接保护）", population:"9-18岁女孩多年龄队列", name_en:"population impact assessment of multi-age-cohort vaccination"}}, {nodeId:"STU017", properties:{label_zh:"研究", study_type:"系统综述", name:"Cochrane系统综述（2剂次方案）", label_en:"Study", outcome:"2剂次方案(0,6-15月)", population:"9-14岁女孩", name_en:"Cochrane systematic review on 2-dose schedule"}}, {nodeId:"STU018", properties:{label_zh:"研究", study_type:"临床试验", name:"HPV疫苗与其他疫苗同时接种安全性研究", label_en:"Study", outcome:"抗体应答无临床相关性干扰", population:"同时接种者", name_en:"studies on safety of concurrent administration with other vaccines"}}, {nodeId:"STU019", properties:{label_zh:"研究", study_type:"流行病学研究", name:"MSM人群HPV感染流行病学研究", label_en:"Study", outcome:"反复持续HPV感染及相关疾病风险", population:"MSM人群", name_en:"epidemiological studies of HPV infection in MSM"}}, {nodeId:"STU021", properties:{label_zh:"研究", study_type:"临床研究/证据评估", name:"27-45岁成人HPV疫苗接种有效性研究", label_en:"Study", outcome:"有效性低/癌症预防潜力低（ACS评估）", name_en:"studies on effectiveness of HPV vaccination in adults 27-45 years", population:"27-45岁成人"}}, {nodeId:"STU022", properties:{label_zh:"研究", study_type:"卫生经济学评估", name:"9价疫苗再接种的成本效益评估", label_en:"Study", outcome:"成本效益比", population:"已完成2v/4v接种者", name_en:"cost-effectiveness evaluations of 9vHPV revaccination"}}] AS row
