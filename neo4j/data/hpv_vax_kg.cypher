UNWIND [{nodeId:"COND001", properties:{label_zh:"条件", name:"无论是否存在HPV感染或细胞学异常", label_en:"Condition"}}, {nodeId:"COND002", properties:{label_zh:"条件", name:"病情允许时", label_en:"Condition"}}, {nodeId:"COND003", properties:{label_zh:"条件", name:"无接种禁忌证", label_en:"Condition"}}, {nodeId:"COND004", properties:{label_zh:"条件", name:"已确诊宫颈/肛门部位鳞状上皮内病变", label_en:"Condition"}}, {nodeId:"COND006", properties:{label_zh:"条件", name:"生命体征平稳时", label_en:"Condition"}}, {nodeId:"COND007", properties:{label_zh:"条件", name:"细胞学异常", label_en:"Condition"}}, {nodeId:"COND008", properties:{label_zh:"条件", name:"HPV-16或18型阳性", label_en:"Condition"}}, {nodeId:"COND009", properties:{label_zh:"条件", name:"临床可疑肛门癌前病变", label_en:"Condition"}}, {nodeId:"COND010", properties:{label_zh:"条件", name:"出现不典型皮损和特殊部位的皮损", label_en:"Condition"}}, {nodeId:"COND011", properties:{label_zh:"条件", name:"存在喘鸣、喉梗阻或呼吸困难", label_en:"Condition"}}, {nodeId:"COND012", properties:{label_zh:"条件", name:"特殊原因需缩短间隔时至少间隔5个月", label_en:"Condition"}}, {nodeId:"COND013", properties:{label_zh:"条件", name:"最短间隔：第1-2剂≥4周，第2-3剂≥16周，第1-3剂≥5个月，1年内完成", label_en:"Condition"}}, {nodeId:"COND015", properties:{label_zh:"条件", name:"WHO认为单剂次可用于9-20岁（超说明书使用）", label_en:"Condition"}}, {nodeId:"COND016", properties:{label_zh:"条件", name:"HPV疫苗与其他疫苗同时接种是安全的", label_en:"Condition"}}, {nodeId:"COND017", properties:{label_zh:"条件", name:"如14岁前未接种", label_en:"Condition"}}, {nodeId:"COND018", properties:{label_zh:"条件", name:"第1剂次接种年龄", label_en:"Condition"}}, {nodeId:"COND019", properties:{label_zh:"条件", name:"过早接种第2剂次HPV疫苗", label_en:"Condition"}}, {nodeId:"COND020", properties:{label_zh:"条件", name:"未充分接种者（not adequately vaccinated）", label_en:"Condition", name_en:"not adequately vaccinated"}}, {nodeId:"COND021", properties:{label_zh:"条件", name:"最低标准（资源受限）", label_en:"Condition", name_en:"standard (minimum)"}}, {nodeId:"COND022", properties:{label_zh:"条件", name:"优先标准（资源充足）", label_en:"Condition", name_en:"standard (preferred)"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:条件;
UNWIND [{nodeId:"COND023", properties:{label_zh:"条件", name:"个体基础上", label_en:"Condition", name_en:"on an individual basis"}}, {nodeId:"COND024", properties:{label_zh:"条件", name:"女孩覆盖率<50%", label_en:"Condition", name_en:"vaccine coverage of girls <50%"}}, {nodeId:"COND026", properties:{label_zh:"条件", name:"最大或加强资源环境", label_en:"Condition", name_en:"maximal or enhanced resource settings"}}, {nodeId:"COND028", properties:{label_zh:"条件", name:"基本资源环境", label_en:"Condition", name_en:"basic resource settings"}}, {nodeId:"COND029", properties:{label_zh:"条件", name:"充分咨询后", label_en:"Condition", name_en:"upon thorough counseling"}}, {nodeId:"COND032", properties:{label_zh:"条件", name:"超说明书使用（单剂次）", label_en:"Condition", name_en:"off-label (single-dose)"}}, {nodeId:"COND033", properties:{label_zh:"条件", name:"可行且可负担、不挤占主要目标或筛查资源", label_en:"Condition", name_en:"only if feasible and affordable, without diverting resources"}}, {nodeId:"COND034", properties:{label_zh:"条件", name:"间隔超过推荐无需重复接种", label_en:"Condition", name_en:"no repeat if recommended interval exceeded"}}, {nodeId:"COND035", properties:{label_zh:"条件", name:"最短间隔：1-2剂≥4周、2-3剂≥12周、1-末剂≥24周", label_en:"Condition", name_en:"minimum intervals: 4/12 weeks, 24 weeks first-to-last"}}, {nodeId:"COND036", properties:{label_zh:"条件", name:"急性中重度疾病或慢性病急性发作（暂缓）", label_en:"Condition", name_en:"moderate/severe acute illness or exacerbation of chronic disease (defer)"}}, {nodeId:"COND037", properties:{label_zh:"条件", name:"轻微急性疾病（不需暂缓）", label_en:"Condition", name_en:"minor acute illness (not a reason to defer)"}}, {nodeId:"COND038", properties:{label_zh:"条件", name:"对酵母速发型超敏反应（9价禁忌）", label_en:"Condition", name_en:"immediate hypersensitivity to yeast (9vHPV contraindication)"}}, {nodeId:"COND039", properties:{label_zh:"条件", name:"对疫苗成分或既往剂次严重过敏反应（绝对禁忌）", label_en:"Condition", name_en:"anaphylaxis to component or prior dose (absolute contraindication)"}}, {nodeId:"COND040", properties:{label_zh:"条件", name:"最可能获益者（27-45岁）", label_en:"Condition", name_en:"people most likely to benefit"}}, {nodeId:"COND042", properties:{label_zh:"条件", name:"意外接种于妊娠期无需干预/无需终止妊娠", label_en:"Condition", name_en:"inadvertent vaccination during pregnancy: no intervention/termination indicated"}}, {nodeId:"COND043", properties:{label_zh:"条件", name:"接种前无需妊娠检测", label_en:"Condition", name_en:"pregnancy testing not required before vaccination"}}, {nodeId:"COND044", properties:{label_zh:"条件", name:"接种前无需HPV/HIV筛查", label_en:"Condition", name_en:"no need to screen for HPV/HIV prior to vaccination"}}, {nodeId:"COND045", properties:{label_zh:"条件", name:"疫苗对已有感染/病变无治疗作用", label_en:"Condition", name_en:"no therapeutic effect on existing infection or lesions"}}, {nodeId:"COND048", properties:{label_zh:"条件", name:"激素避孕不影响免疫应答", label_en:"Condition", name_en:"hormonal contraceptives have no effect on immune response"}}, {nodeId:"COND050", properties:{label_zh:"条件", name:"既往剂次后轻中度反应非禁忌", label_en:"Condition", name_en:"mild/moderate reactions after previous dose are not contraindications"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:条件;
UNWIND [{nodeId:"COND052", properties:{label_zh:"条件", name:"意大利国家疫苗预防计划2017-2019框架", label_en:"Condition", name_en:"Italian National Vaccinal Prevention Plan 2017-2019"}}, {nodeId:"COND055", properties:{label_zh:"条件", name:"有意愿获得额外型别保护", label_en:"Condition", name_en:"if the person wants protection against additional HPV types"}}, {nodeId:"COND056", properties:{label_zh:"条件", name:"须通过III期临床试验（疫苗选择）", label_en:"Condition", name_en:"must have undergone Phase 3 trials"}}, {nodeId:"COND057", properties:{label_zh:"条件", name:"12个月间隔方案GMT更高", label_en:"Condition", name_en:"12-month schedule results in higher GMTs"}}, {nodeId:"COND060", properties:{label_zh:"条件", name:"无论性活动、既往暴露或性取向", label_en:"Condition", name_en:"regardless of sexual activity, prior exposure, or sexual orientation"}}, {nodeId:"COND061", properties:{label_zh:"条件", name:"无论行为或医学风险因素", label_en:"Condition", name_en:"regardless of behavioral or medical risk factors"}}, {nodeId:"COND062", properties:{label_zh:"条件", name:"资源允许时向上扩展补种", label_en:"Condition", name_en:"resources allow, expand upward in catch-up efforts"}}, {nodeId:"COND063", properties:{label_zh:"条件", name:"优先人群覆盖≥50%（2剂，目标80%）", label_en:"Condition", name_en:"minimum coverage ≥50% with two doses, target 80%"}}, {nodeId:"COND064", properties:{label_zh:"条件", name:"视当地政策与资源", label_en:"Condition", name_en:"depending on local policies and resources"}}, {nodeId:"COND066", properties:{label_zh:"条件", name:"FDA许可至45岁", label_en:"Condition", name_en:"FDA-approved through age 45"}}, {nodeId:"COND067", properties:{label_zh:"条件", name:"45岁以上未许可", label_en:"Condition", name_en:"not licensed for use in adults aged >45 years"}}, {nodeId:"COND070", properties:{label_zh:"条件", name:"既往疫苗种类未知或不可得", label_en:"Condition", name_en:"prior vaccine unknown or unavailable"}}, {nodeId:"COND071", properties:{label_zh:"条件", name:"已完成2价或4价接种程序者", label_en:"Condition", name_en:"completed 2vHPV or 4vHPV vaccination series"}}, {nodeId:"COND072", properties:{label_zh:"条件", name:"疫苗供应和成本无限制时", label_en:"Condition", name_en:"in the absence of limitations related to availability and costs"}}, {nodeId:"COND073", properties:{label_zh:"条件", name:"与国家指南和项目一致", label_en:"Condition", name_en:"in agreement with national guidelines and programs"}}, {nodeId:"COND074", properties:{label_zh:"条件", name:"考虑既往暴露可能性与未来风险", label_en:"Condition", name_en:"consider likelihood of previous exposure and future risks"}}, {nodeId:"COND075", properties:{label_zh:"条件", name:"适龄男孩和女孩的家长（教育对象）", label_en:"Condition", name_en:"parents of daughters and sons"}}, {nodeId:"COND076", properties:{label_zh:"条件", name:"与含白喉/破伤风/百日咳成分疫苗同时", label_en:"Condition", name_en:"concomitantly with diphtheria, tetanus and acellular pertussis containing vaccines"}}, {nodeId:"COND077", properties:{label_zh:"条件", name:"使用单独注射器和不同部位", label_en:"Condition", name_en:"using separate syringes and different injection sites"}}, {nodeId:"COND078", properties:{label_zh:"条件", name:"分阶段引入仅为短期替代", label_en:"Condition", name_en:"phased introductions only short-term alternative"}}] AS row
CREATE (n:Entity{nodeId: row.nodeId}) SET n += row.properties SET n:条件;
UNWIND [{nodeId:"COND079", properties:{label_zh:"条件", name:"免疫功能正常（immune competent）", label_en:"Condition", name_en:"immune competent"}}, {nodeId:"COND080", properties:{label_zh:"条件", name:"9岁或10岁开始提供", label_en:"Condition", name_en:"start offering at age 9 or 10 years"}}, {nodeId:"COND082", properties:{label_zh:"条件", name:"第二剂至少间隔6个月", label_en:"Condition", name_en:"second dose at least 6 months after first"}}, {nodeId:"COND083", properties:{label_zh:"条件", name:"间隔可长达12-15个月", label_en:"Condition", name_en:"interval may be up to 12 to 15 months"}}, {nodeId:"COND084", properties:{label_zh:"条件", name:"学校第7学年（约12-13岁）", label_en:"Condition", name_en:"School Year 7 (approximately 12-13 years)"}}, {nodeId:"COND085", properties:{label_zh:"条件", name:"可行时", label_en:"Condition", name_en:"if feasible"}}, {nodeId:"COND087", properties:{label_zh:"条件", name:"资源充足地区女孩覆盖率低时扩展至男孩", label_en:"Condition", name_en:"low coverage of priority female population, may extend to boys"}}, {nodeId:"COND088", properties:{label_zh:"条件", name:"女孩覆盖率≥50%时证据不足以推荐或反对男孩接种", label_en:"Condition", name_en:"coverage ≥50%: insufficient data to recommend for or against boys"}}, {nodeId:"COND089", properties:{label_zh:"条件", name:"最短间隔：1-2剂≥4周、2-3剂≥12周、1-末剂≥20周（澳）", label_en:"Condition", name_en:"minimum intervals: 4/12 weeks, 20 weeks first-to-last (AU)"}}, {nodeId:"COND090", properties:{label_zh:"条件", name:"9-14岁首剂者≥15岁后沿用同剂次方案", label_en:"Condition", name_en:"first dose at 9-14y, same schedule applies at ≥15y"}}, {nodeId:"COND091", properties:{label_zh:"条件", name:"经临床医生咨询后", label_en:"Condition", name_en:"through consultation with a clinician"}}, {nodeId:"COND092", properties:{label_zh:"条件", name:"最短间隔：1-2剂≥4周、2-3剂≥12周、1-3剂≥5个月（韩）", label_en:"Condition", name_en:"minimum intervals: 4/12 weeks, 5 months first-to-last (KR)"}}, {nodeId:"COND093", properties:{label_zh:"条件", name:"波兰预防免疫计划（PIP）框架", label_en:"Condition", name_en:"within the Polish Preventive Immunization Programme"}}, {nodeId:"COND094", properties:{label_zh:"条件", name:"基于疗效终点、招标价格与当地HPV基因型分布的药物经济学分析", label_en:"Condition", name_en:"independent pharmaco-economic analysis (efficacy endpoints, tender price, local genotype distribution)"}}, {nodeId:"COND095", properties:{label_zh:"条件", name:"超出免费计划年龄者按说明书自费接种", label_en:"Condition", name_en:"older than programme ages, vaccinated per prescribing information at own cost"}}, {nodeId:"COND096", properties:{label_zh:"条件", name:"中央（媒体）/区域（会议）/个体（诊所）多层次教育", label_en:"Condition", name_en:"central (media), regional (conferences), individual (clinics) education"}}, {nodeId:"COND097", properties:{label_zh:"条件", name:"免疫受损女性25岁起、每3-5年筛查", label_en:"Condition", name_en:"immunocompromised women: from age 25, every 3-5 years"}}, {nodeId:"COND098", properties:{label_zh:"条件", name:"2030年前15岁女孩覆盖率达90%（WHO全球战略）", label_en:"Condition", name_en:"90% of girls fully vaccinated by age 15 by 2030 (WHO Global Strategy)"}}, {nodeId:"COND099", properties:{label_zh:"条件", name:"与教育、筛查、诊断、治疗等综合策略协调实施", label_en:"Condition", name_en:"as part of a coordinated comprehensive prevention strategy"}}, {nodeId:"COND100", properties:{label_zh:"条件", name:"不因其他干预措施无法同步实施而推迟引入", label_en:"Condition", name_en:"introduction should not be deferred because other interventions cannot be implemented simultaneously"}}] AS row
