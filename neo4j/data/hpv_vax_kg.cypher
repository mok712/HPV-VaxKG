UNWIND [{nodeId:"STU023", properties:{label_zh:"研究", study_type:"实施研究", name:"学校接种项目效果研究", label_en:"Study", outcome:"覆盖率与公平性", population:"学龄青少年", name_en:"studies on effectiveness of school-based vaccination programmes"}}, {nodeId:"STU024", properties:{label_zh:"研究", study_type:"流行病学研究", name:"成人HPV暴露流行病学研究", label_en:"Study", outcome:"既往暴露于疫苗型别比例高", population:"成人", name_en:"epidemiological studies on HPV exposure in adults"}}, {nodeId:"STU025", properties:{label_zh:"研究", study_type:"流行病学研究", name:"HPV疫苗型别覆盖与宫颈癌病因学研究", label_en:"Study", outcome:"宫颈癌可由非疫苗型别HPV引起", population:"一般人群", name_en:"studies on HPV type coverage and cervical cancer etiology"}}, {nodeId:"STU026", properties:{label_zh:"研究", study_type:"比较研究/证据综述", name:"HPV疫苗免疫原性效力效果比较研究", label_en:"Study", outcome:"2/4/9价疫苗免疫原性、效力、效果相当", name_en:"comparative studies on immunogenicity, efficacy and effectiveness of HPV vaccines", population:"各疫苗受试者"}}, {nodeId:"STU027", properties:{label_zh:"研究", study_type:"流行病学研究", name:"旅行者与卫生工作者HPV感染风险研究", label_en:"Study", outcome:"HPV感染风险不增加", population:"旅行者/卫生工作者", name_en:"studies on HPV infection risk in travelers and health workers"}}, {nodeId:"STU028", properties:{label_zh:"研究", study_type:"临床研究/安全性监测", name:"免疫功能低下/HIV感染者HPV疫苗安全性研究", label_en:"Study", outcome:"疫苗安全且耐受良好", name_en:"safety studies of HPV vaccines in immunocompromised or HIV-infected persons", population:"免疫受损者/HIV感染者"}}, {nodeId:"STU029", properties:{label_zh:"研究", study_type:"上市前临床试验汇总", name:"HPV疫苗上市前临床试验安全性数据汇总（CDC）", label_en:"Study", outcome:"局部反应20%-90%、发热10%-13%与安慰剂相似", name_en:"CDC summary of prelicensure clinical trial safety data", population:"各年龄接种者"}}, {nodeId:"STU030", properties:{label_zh:"研究", study_type:"临床研究", name:"既往感染HPV者接种获益研究", label_en:"Study", outcome:"仍可获残余获益（预防未感染型别）", population:"既往HPV感染者", name_en:"studies on residual benefit of vaccination in previously infected persons"}}, {nodeId:"STU031", properties:{label_zh:"研究", study_type:"免疫学/流行病学研究", name:"接种年龄与免疫应答及HPV阳性率关系研究", label_en:"Study", outcome:"早期接种免疫应答最佳、HPV阳性率更低", population:"各年龄接种者", name_en:"studies on age at vaccination, immunologic response and HPV positivity"}}, {nodeId:"STU032", properties:{label_zh:"研究", study_type:"临床研究", name:"既往感染已清除者疫苗接种效果研究", label_en:"Study", outcome:"疫苗仍有效", population:"既往感染已清除的性活跃者", name_en:"studies on vaccine effectiveness in persons with cleared infections"}}, {nodeId:"STU033", properties:{label_zh:"研究", study_type:"证据汇总", name:"HPV疫苗耐受性证据汇总", label_en:"Study", outcome:"三种HPV疫苗总体耐受性良好", population:"各疫苗受试者", name_en:"summary of evidence on HPV vaccine tolerability"}}, {nodeId:"STU034", properties:{label_zh:"研究", study_type:"临床研究", name:"CIN治疗后接种降低复发率研究", label_en:"Study", outcome:"病变复发风险降低", population:"CIN治疗后的HPV疫苗未接种女性", name_en:"studies on reduced recurrence after CIN treatment with vaccination"}}, {nodeId:"STU035", properties:{label_zh:"研究", study_type:"临床研究/有效性分析", name:"22-26岁大年龄组接种有效性研究", label_en:"Study", outcome:"接种降低癌症风险效果较差", name_en:"studies on effectiveness of vaccination at ages 22-26 years", population:"22-26岁未接种或未完成系列者"}}, {nodeId:"STU036", properties:{label_zh:"研究", study_type:"实施研究/项目评估", name:"各国性别中立HPV疫苗接种实施经验评估", label_en:"Study", outcome:"性别中立接种可行且应作为优先理念", name_en:"assessment of gender-neutral vaccination implementation across countries", population:"实施性别中立接种的国家"}}] AS row
